  <Item class="ServerScriptService" referent="RBX1457">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX1458">
      <Properties>
        <string name="Name">Config</string>
        <ProtectedString name="Source">-- The admission cap must ALSO be set to 50 in Creator Dashboard place settings.
return {
 MinPlayers=2, MaxPlayers=50, Day=480, Night=360, Cycles=3, Intermission=30,
 Range=10, InspectCooldown=20, CaptureCooldown=5, FeedCooldown=8, InfectCooldown=25,
 SaveInterval=90, LockLifetime=300, MaxLevel=30,
 -- Studio uses disposable profiles by default. Never enable API access on live data for tests.
 StudioPersistence=false,
}
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1459">
      <Properties>
        <string name="Name">Progression</string>
        <ProtectedString name="Source">-- Server-owned RPG profiles, session leases, quests and contextual interactions.
local Players=game:GetService('Players')
local DSS=game:GetService('DataStoreService')
local RunService=game:GetService('RunService')
local Http=game:GetService('HttpService')
local Config=require(script.Parent.Config)
local Adventure=require(script.Parent.AdventureRules)
local RPG={}
local profiles={}
local session=game.JobId..':'..Http:GenerateGUID(false)
local temporary=RunService:IsStudio() and not Config.StudioPersistence
local store=not temporary and DSS:GetDataStore('ApusRPG_v1') or nil
local closing=false
local classes={'Vanator','Cercetas','Carturar'}
local classNames={Vanator='Hunter',Cercetas='Scout',Carturar='Scholar'}
local quests={
 {kind='Herb',need=5,text='Gather 5 herbs in the southwestern forest',xp=100,gold=50},
 {kind='Ore',need=4,text='Collect 4 ore deposits at the eastern mine',xp=140,gold=70},
 {kind='Relic',need=3,text='Find 3 relics in the northern ruins',xp=180,gold=90},
 {kind='Ritual',need=1,text='Activate the monastery altar to the south',xp=240,gold=120},
}
local function integer(n,max)
 if type(n)~='number' or n~=n or n==math.huge or n==-math.huge then return 0 end
 return math.clamp(math.floor(n),0,max)
end
local function clean(raw)
 raw=type(raw)=='table' and raw or {}
 local q=integer(raw.quest,4); if q&lt;1 then q=1 end
 local class='Vanator'
 for _,v in ipairs(classes) do if raw.class==v then class=v end end
 return {xp=integer(raw.xp,10000000),gold=integer(raw.gold,10000000),
  lantern=integer(raw.lantern,3),class=class,quest=q,
  count=integer(raw.count,quests[q].need),accepted=raw.accepted==true,
  completed=integer(raw.completed,1000000),wins=integer(raw.wins,1000000)}
end
local function copy(d) local c={}; for k,v in pairs(d) do c[k]=v end; return c end
function RPG.Level(xp)
 return math.min(Config.MaxLevel,1+math.floor(math.sqrt(xp/100)))
end
local function publish(p,s)
 local d=s.data
 p:SetAttribute('RPGReady',true)
 p:SetAttribute('LanternTier',d.lantern)
 local stats=p:FindFirstChild('leaderstats')
 if stats then stats.Level.Value=RPG.Level(d.xp); stats.Gold.Value=d.gold end
end
local function reward(p,s,xp,gold)
 -- No client can supply reward amounts, item prices or quest completion.
 s.data.xp=math.min(10000000,s.data.xp+xp)
 s.data.gold=math.min(10000000,s.data.gold+gold)
 publish(p,s)
end
local function notice(p,text) p:SetAttribute('RPGNotice',text) end
function RPG.Ready(p) return profiles[p]~=nil and not profiles[p].leaving end
function RPG.Join(p)
 if closing then p:Kick('The server is shutting down. Please reconnect.'); return end
 local data=nil
 if temporary then data=clean(nil) else
  for attempt=1,3 do
   local ok,result=pcall(function()
    return store:UpdateAsync('u_'..p.UserId,function(old)
     old=type(old)=='table' and old or {}
     local lock=old.lock
     if type(lock)=='table' and lock.id~=session and type(lock.at)=='number'
       and os.time()-lock.at&lt;Config.LockLifetime then return nil end
     return {version=1,data=clean(old.data),lock={id=session,at=os.time()}}
    end)
   end)
   if ok and type(result)=='table' and result.lock and result.lock.id==session then
    data=clean(result.data); break
   end
   task.wait(attempt)
  end
 end
 if not data then
  if p.Parent==Players then p:Kick('Your profile is unavailable or open on another server. Please try again in a few minutes.') end
  return
 end
 profiles[p]={data=data,saving=false,leaving=false,lastSave=os.clock(),nodes={},visits={},nextUse=0,packages={}}
 if p.Parent~=Players or closing then RPG.Remove(p); return end
 local stats=Instance.new('Folder'); stats.Name='leaderstats'; stats.Parent=p
 for _,n in ipairs({'Level','Gold'}) do local v=Instance.new('IntValue'); v.Name=n; v.Parent=stats end
 p:SetAttribute('SaveStatus',temporary and 'TEST - temporary progress' or 'Saving enabled')
 notice(p,'Tip: the quest board is beside the fountain. Interact: R / L1 / touch.')
 publish(p,profiles[p])
end
local function save(p,release)
 local s=profiles[p]; if not s then return true end
 local deadline=os.clock()+20
 while s.saving and os.clock()&lt;deadline do task.wait(.1) end
 if s.saving then return false end
 s.saving=true
 if temporary then s.saving=false; return true end
 local payload=copy(s.data)
 local succeeded=false
 local lost=false
 for attempt=1,3 do
  local ok,result=pcall(function()
   return store:UpdateAsync('u_'..p.UserId,function(old)
    if type(old)~='table' or type(old.lock)~='table' or old.lock.id~=session then
     lost=true; return nil
    end
    return {version=1,data=payload,lock=not release and {id=session,at=os.time()} or nil}
   end)
  end)
  if ok and result and not lost then succeeded=true; break end
  if lost then break end
  task.wait(attempt)
 end
 s.saving=false
 if succeeded then
  s.lastSave=os.clock(); p:SetAttribute('SaveStatus','Saved')
 else
  p:SetAttribute('SaveStatus','Save failed - retrying automatically')
  warn('Apus profile save failed for user '..p.UserId)
  if lost or os.clock()-s.lastSave&gt;Config.LockLifetime-30 then
   s.leaving=true
   if p.Parent==Players then p:Kick('The connection to your saved profile was lost. Please reconnect.') end
  end
 end
 return succeeded
end
function RPG.Remove(p)
 local s=profiles[p]; if not s then return end
 if s.removing then return end
 s.removing=true; s.leaving=true
 local ok=save(p,true)
 if not ok then warn('Final save failed; lock expires automatically for '..p.UserId) end
 profiles[p]=nil
end
function RPG.Snapshot(p)
 local s=profiles[p]
 if not s then return {ready=false} end
 local d=s.data; local q=quests[d.quest]
 local adventure=s.contractAt and ('Delivery: '..(s.packageCount or 0)..'/3 | '..math.max(0,180-math.floor(os.clock()-s.contractAt))..'s | Inn')
  or (s.clue and 'Seal deciphered: activate the shrine at night' or 'Contracts at the inn | Chapel clue by day')
 local signature=table.concat({d.xp,d.gold,d.class,d.lantern,d.quest,d.count,tostring(d.accepted),d.completed,adventure,p:GetAttribute('SaveStatus') or '',p:GetAttribute('RPGNotice') or ''},'|')
 if signature==s.snapshotKey then return s.snapshot end
 s.snapshotKey=signature
 s.snapshot={ready=true,level=RPG.Level(d.xp),xp=d.xp,nextXP=Config.MaxLevel&gt;RPG.Level(d.xp)
  and 100*RPG.Level(d.xp)^2 or d.xp,gold=d.gold,class=d.class,lantern=d.lantern,
  quest=d.accepted and (q.text..' ('..d.count..'/'..q.need..')') or 'Visit the quest board in the market square',
  completed=d.completed,adventure=adventure,save=p:GetAttribute('SaveStatus'),notice=p:GetAttribute('RPGNotice')}
 return s.snapshot
end
function RPG.RoundReward(p,won)
 local s=profiles[p]; if not s or s.leaving then return end
 reward(p,s,won and 160 or 60,won and 80 or 25)
 if won then s.data.wins=s.data.wins+1 end
end
local function progress(p,s,kind)
 local d=s.data; local q=quests[d.quest]
 if not d.accepted or kind~=q.kind or d.count&gt;=q.need then return end
 d.count=d.count+1
 notice(p,d.count&gt;=q.need and 'Objective complete. Return to the quest board for your reward.'
  or (q.text..' '..d.count..'/'..q.need))
end
function RPG.Init(canInteract)
 local nodes=workspace.Village:WaitForChild('WorldNodes')
 for _,part in ipairs(nodes:GetChildren()) do
  if part:IsA('BasePart') and part.Name~='RobuxShop' then
   local name=part.Name
   local prompt=Instance.new('ProximityPrompt')
   prompt.Name='RPGInteract'; prompt.MaxActivationDistance=10
   prompt.RequiresLineOfSight=true; prompt.HoldDuration=.5
   prompt.KeyboardKeyCode=Enum.KeyCode.R; prompt.GamepadKeyCode=Enum.KeyCode.ButtonL1
   prompt.ObjectText=name; prompt.ActionText='Interact'
   if name:match('^Herb_') then prompt.ObjectText='Herbs'; prompt.ActionText='Gather'
   elseif name:match('^Ore_') then prompt.ObjectText='Ore'; prompt.ActionText='Mine'
   elseif name:match('^Relic_') then prompt.ObjectText='Relic'; prompt.ActionText='Investigate'
   elseif name=='QuestBoard' then prompt.ObjectText='Quests'; prompt.ActionText='Accept / Claim reward'
   elseif name=='Merchant' then prompt.ObjectText='Blacksmith'; prompt.ActionText='Lantern +1 (100/200/300 gold)'
   elseif name=='Healer' then prompt.ObjectText='Healer'; prompt.ActionText='Heal (30 gold)'
   elseif name=='Trainer' then prompt.ObjectText='Guild trainer'; prompt.ActionText='Change specialization'
   elseif name=='TravelGate' then prompt.ObjectText='Enter village'; prompt.ActionText='Explore'
   elseif name=='ContractBoard' then prompt.ObjectText='The Raven Inn'; prompt.ActionText='Contract: 3 supplies / 180s'
   elseif name:match('^Supply_') then prompt.ObjectText='Supplies'; prompt.ActionText='Collect for the inn'
   elseif name=='DawnClue' then prompt.ObjectText='Chapel inscription'; prompt.ActionText='Read by daylight'
   elseif name=='DawnShrine' then prompt.ObjectText='Dawn Seal'; prompt.ActionText='Night ritual'
   elseif name=='Campfire' then prompt.ObjectText='Inn hearth'; prompt.ActionText='Cook: 2 herbs / +25 HP'
   elseif name:match('^Expedition_') then prompt.ObjectText='Expedition'; prompt.ActionText='Explore 3 landmarks'
   elseif name=='RitualAltar' then prompt.ObjectText='Altar'; prompt.ActionText='Perform ritual' end
   prompt.Parent=part
   prompt.Triggered:Connect(function(p)
    local s=profiles[p]; local char=p.Character
    local root=char and char:FindFirstChild('HumanoidRootPart')
    local hum=char and char:FindFirstChildOfClass('Humanoid')
    if not s or s.leaving or not root or not hum or hum.Health&lt;=0 or not canInteract(p)
      or not prompt.Enabled or (root.Position-part.Position).Magnitude&gt;10 then return end
    local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude
    ray.FilterDescendantsInstances={char,part}
    if workspace:Raycast(root.Position,part.Position-root.Position,ray) then return end
    local now=os.clock(); if now&lt;s.nextUse then return end
    s.nextUse=now+1
    local d=s.data
    if Adventure.ContractExpired(s.contractAt,now) then
     s.contractAt=nil; s.packages={}; s.packageCount=0
     notice(p,'Contract expired. Accept another at the inn.')
    end
    if name=='TravelGate' then
     if p:GetAttribute('RoundActive') then return end
     char:PivotTo(CFrame.new(0,4,-20)); notice(p,'PvE exploration. You will join the next round.'); return
    elseif name=='ContractBoard' then
     if s.contractAt then
      if Adventure.CanDeliver(s.contractAt,now,s.packageCount or 0) then
       reward(p,s,80,40); s.contractAt=nil; s.packages={}; s.packageCount=0; s.contractReady=now+180
       notice(p,'Supplies delivered: +80 XP / +40 gold. Next contract in 3 minutes.')
      else notice(p,'Collect supplies from the market, mill and farm. Return within 180s.') end
     elseif now&lt;(s.contractReady or 0) then notice(p,'The inn is stocked. Come back later.')
     elseif workspace:GetAttribute('ApusNight') then notice(p,'Accept contracts by day. Search for the seal at night.')
     else s.contractAt=now; s.packages={}; s.packageCount=0; notice(p,'Contract accepted: market, mill, farm -&gt; inn, within 180s.') end
    elseif name:match('^Supply_') then
     if not s.contractAt then notice(p,'Accept a contract at the inn first.')
     elseif s.packages[name] then notice(p,'You have already collected these supplies.')
     else s.packages[name]=true; s.packageCount=(s.packageCount or 0)+1; notice(p,'Supplies '..s.packageCount..'/3. Return to the inn.') end
    elseif name=='DawnClue' then
     if workspace:GetAttribute('ApusNight') then notice(p,'The inscription can only be read by daylight.')
     else s.clue=true; notice(p,'Clue: tonight, awaken the seal in the monastery courtyard.') end
    elseif name=='DawnShrine' then
     if Adventure.CanRitual(s.clue,workspace:GetAttribute('ApusNight'),now,s.ritualReady) then
      s.clue=false; s.ritualReady=now+300; reward(p,s,120,60)
      notice(p,'Seal restored: +120 XP / +60 gold. Investigate again after 5 minutes.')
     else notice(p,'You need the chapel clue, nighttime and a ready ritual (5-minute cooldown).') end
    elseif name=='Campfire' then
     if hum.Health&gt;=hum.MaxHealth then notice(p,'Your health is already full.')
     elseif (s.herbs or 0)&lt;2 then notice(p,'Gather 2 herbs to cook a warm meal.')
     elseif now&lt;(s.cookReady or 0) then notice(p,'Wait 45 seconds between meals.')
     else s.herbs=s.herbs-2; s.cookReady=now+45; hum.Health=math.min(hum.MaxHealth,hum.Health+25); notice(p,'Warm meal: +25 HP. Infection remains.') end
    elseif name=='QuestBoard' then
     local q=quests[d.quest]
     if not d.accepted then d.accepted=true; notice(p,q.text)
     elseif d.count&gt;=q.need then
      reward(p,s,q.xp,q.gold); d.completed=d.completed+1
      d.quest=d.quest%#quests+1; d.count=0; d.accepted=false
      notice(p,'Reward: '..q.xp..' XP, '..q.gold..' gold. Accept the next quest.')
     else notice(p,q.text..' '..d.count..'/'..q.need) end
    elseif name=='Merchant' then
     local cost=100*(d.lantern+1)
     if d.lantern&gt;=3 then notice(p,'Your lantern is already fully upgraded.')
     elseif d.gold&lt;cost then notice(p,'You need '..cost..' gold.')
     else d.gold=d.gold-cost; d.lantern=d.lantern+1; publish(p,s); notice(p,'Lantern permanently upgraded.') end
    elseif name=='Healer' then
     if hum.Health&gt;=hum.MaxHealth then notice(p,'Your health is already full.')
     elseif d.gold&lt;30 then notice(p,'Healing costs 30 gold.')
     else d.gold=d.gold-30; hum.Health=hum.MaxHealth; publish(p,s); notice(p,'Health restored. Infection is NOT cured.') end
    elseif name=='Trainer' then
     local index=table.find(classes,d.class) or 1
     d.class=classes[index%#classes+1]; publish(p,s)
     notice(p,'Specialization: '..classNames[d.class]..'. Hunter: +2 gathering gold; Scout: +20 expedition XP; Scholar: +2 gathering XP.')
    elseif name:match('^Expedition_') then
     s.visits[name]=true
     local count=0; for _ in pairs(s.visits) do count=count+1 end
     if count&gt;=3 then
      if now&gt;=(s.expeditionAt or 0) then
       reward(p,s,d.class=='Cercetas' and 200 or 180,90)
       s.expeditionAt=now+300; s.visits={}; notice(p,'Expedition complete: XP and gold awarded.')
      else notice(p,'Expedition rewards are available once every 5 minutes.') end
     else notice(p,'Expedition: '..count..'/3 landmarks visited (forest, mine, ruins).') end
    else
     local kind=name:match('^(%a+)_')
     if name=='RitualAltar' then kind='Ritual' end
     if kind~='Herb' and kind~='Ore' and kind~='Relic' and kind~='Ritual' then return end
     -- Personal node cooldowns: 50 players never compete for one resource spawn.
     if now&lt;(s.nodes[name] or 0) then notice(p,'This resource is replenishing for you.'); return end
     s.nodes[name]=now+60
     if kind=='Herb' then s.herbs=math.min(10,(s.herbs or 0)+1) end
     reward(p,s,d.class=='Carturar' and 10 or 8,d.class=='Vanator' and 6 or 4)
     progress(p,s,kind)
    end
   end)
  end
 end
 task.spawn(function()
  while not closing do
   task.wait(2)
   -- Spread saves across the interval instead of issuing 50 writes at once.
   for p,s in pairs(profiles) do
    if not s.leaving and not s.saving and os.clock()-s.lastSave&gt;=Config.SaveInterval then
     task.spawn(save,p,false); task.wait(.2)
    end
   end
  end
 end)
 game:BindToClose(function()
  closing=true
  for p in pairs(profiles) do task.spawn(RPG.Remove,p) end
  local deadline=os.clock()+25
  while next(profiles) and os.clock()&lt;deadline do task.wait(.1) end
 end)
end
return RPG
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1460">
      <Properties>
        <string name="Name">Monetization</string>
        <ProtectedString name="Source">local Players=game:GetService('Players')
local Marketplace=game:GetService('MarketplaceService')
local RS=game:GetService('ReplicatedStorage')
local catalog=require(RS:WaitForChild('MonetizationConfig'))
local Monetization={}
local function decorate(p,char)
 if p.Character~=char then return end
 local head=char:FindFirstChild('Head')
 if not head then return end
 local aura=char:FindFirstChild('PaidMoonAura')
 if p:GetAttribute('OwnsMoonAura') and not aura then
  aura=Instance.new('Highlight'); aura.Name='PaidMoonAura'
  aura.FillTransparency=1; aura.OutlineColor=Color3.fromRGB(114,173,255)
  aura.DepthMode=Enum.HighlightDepthMode.Occluded; aura.Parent=char
 end
 if p:GetAttribute('OwnsSupporter') and not head:FindFirstChild('SupporterTitle') then
  local board=Instance.new('BillboardGui'); board.Name='SupporterTitle'
  board.Size=UDim2.fromOffset(180,28); board.StudsOffset=Vector3.new(0,3,0); board.MaxDistance=60
  local text=Instance.new('TextLabel'); text.Size=UDim2.fromScale(1,1)
  text.BackgroundTransparency=1; text.Text='VILLAGE SUPPORTER'
  text.TextColor3=Color3.fromRGB(245,211,124); text.TextSize=12; text.Parent=board; board.Parent=head
 end
end
function Monetization.Refresh(p,onlyID)
 for _,entry in ipairs(catalog) do
  if entry.id&gt;0 and (not onlyID or entry.id==onlyID) then
   local ok,owns=pcall(function() return Marketplace:UserOwnsGamePassAsync(p.UserId,entry.id) end)
   if ok and p.Parent==Players then p:SetAttribute('Owns'..entry.key,owns) end
  end
 end
 if p.Character then decorate(p,p.Character) end
end
function Monetization.Join(p)
 p.CharacterAdded:Connect(function(char)
  char:WaitForChild('Head',10); decorate(p,char)
 end)
 task.spawn(Monetization.Refresh,p)
end
function Monetization.Init()
 local remote=Instance.new('RemoteEvent'); remote.Name='OpenRobuxShop'; remote.Parent=RS
 -- This is server -&gt; client only. No remote grants entitlements or currency.
 local part=workspace.Village.WorldNodes:WaitForChild('RobuxShop')
 local prompt=Instance.new('ProximityPrompt'); prompt.ActionText='Browse cosmetics'
 prompt.ObjectText='Robux Shop'; prompt.KeyboardKeyCode=Enum.KeyCode.R
 prompt.GamepadKeyCode=Enum.KeyCode.ButtonL1; prompt.MaxActivationDistance=10
 prompt.HoldDuration=.3; prompt.Parent=part
 local last={}
 prompt.Triggered:Connect(function(p)
  local char=p.Character; local root=char and char:FindFirstChild('HumanoidRootPart')
  local hum=char and char:FindFirstChildOfClass('Humanoid')
  if not root or not hum or hum.Health&lt;=0 or p:GetAttribute('Captured') or not prompt.Enabled
    or (root.Position-part.Position).Magnitude&gt;10 or os.clock()&lt;(last[p] or 0) then return end
  local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
  params.FilterDescendantsInstances={char,part}
  if workspace:Raycast(root.Position,part.Position-root.Position,params) then return end
  last[p]=os.clock()+2; remote:FireClient(p)
 end)
 Marketplace.PromptGamePassPurchaseFinished:Connect(function(p,id,purchased)
  if purchased then task.spawn(Monetization.Refresh,p,id) end
 end)
 Players.PlayerRemoving:Connect(function(p) last[p]=nil end)
end
return Monetization
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1461">
      <Properties>
        <string name="Name">Rules</string>
        <ProtectedString name="Source">-- Pure rules shared by the round controller and behavior tests.
local Rules={}
function Rules.CryptCount(players)
 return math.max(1,math.min(5,math.ceil(players/10)))
end
function Rules.InitialVampires(players)
 return Rules.CryptCount(players)
end
function Rules.VampireVictory(humans,vampires)
 return humans==0 and vampires&gt;0
end
function Rules.JailSlot(prisoners,count)
 local used={}; local sizes={}
 for i=1,count do used[i]={}; sizes[i]=0 end
 for _,s in ipairs(prisoners) do
  if s.jail and s.jail&lt;=count then
   sizes[s.jail]=sizes[s.jail]+1; used[s.jail][s.jailSlot or 0]=true
  end
 end
 local best=1
 for i=2,count do if sizes[i]&lt;sizes[best] then best=i end end
 local slot=0; while used[best][slot] do slot=slot+1 end
 return best,slot
end
return Rules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1462">
      <Properties>
        <string name="Name">Weapons</string>
        <ProtectedString name="Source">local Weapons={}
local Combat=require(game:GetService('ReplicatedStorage'):WaitForChild('CombatRules'))
local function piece(tool,name,size,offset,color,handle)
 local part=Instance.new('Part'); part.Name=name; part.Size=size
 part.Color=color; part.Material=Enum.Material.Metal
 part.CanCollide=false; part.CanTouch=false; part.CanQuery=false; part.Massless=true
 part.CastShadow=false; part.Parent=tool
 if handle then
  part.CFrame=handle.CFrame*CFrame.new(offset)
  local weld=Instance.new('WeldConstraint'); weld.Part0=handle; weld.Part1=part; weld.Parent=part
 end
 return part
end
function Weapons.Give(p)
 local pack=p:WaitForChild('Backpack',10); if not pack then return end
 for _,old in ipairs(pack:GetChildren()) do if old:GetAttribute('ApusWeapon') then old:Destroy() end end
 -- Everyone receives the same gear. Inventory never leaks the secret role by day.
 for _,key in ipairs({'SilverSword','Crossbow','Claws','Crucifix','HolyWater','WoodenStake'}) do
  local w=Combat.Weapons[key]
  local tool=Instance.new('Tool'); tool.Name=w.name; tool.ToolTip=w.name
  tool.CanBeDropped=false; tool:SetAttribute('ApusWeapon',key)
  tool.Grip=CFrame.new(0,-.6,0)
  local handle=piece(tool,'Handle',Vector3.new(.3,1.2,.3),Vector3.zero,Color3.fromRGB(69,47,38))
  if key=='SilverSword' then
   piece(tool,'Blade',Vector3.new(.30,3,.12),Vector3.new(0,2,0),Color3.fromRGB(188,211,227),handle)
   piece(tool,'Guard',Vector3.new(1.2,.18,.25),Vector3.new(0,.65,0),Color3.fromRGB(163,131,73),handle)
  elseif key=='Crossbow' then
   piece(tool,'Stock',Vector3.new(.4,.45,2),Vector3.new(0,.4,-.6),Color3.fromRGB(109,75,48),handle)
   piece(tool,'Bow',Vector3.new(2.6,.15,.2),Vector3.new(0,.5,-1.4),Color3.fromRGB(158,165,175),handle)
  elseif key=='Crucifix' then
   piece(tool,'CrossStem',Vector3.new(.18,1.5,.18),Vector3.new(0,1,0),Color3.fromRGB(195,190,157),handle)
   piece(tool,'CrossArm',Vector3.new(.95,.18,.18),Vector3.new(0,1.35,0),Color3.fromRGB(195,190,157),handle)
  elseif key=='HolyWater' then
   local bottle=piece(tool,'HolyWaterVial',Vector3.new(.65,1.1,.65),Vector3.new(0,.85,0),Color3.fromRGB(134,198,215),handle)
   bottle.Material=Enum.Material.Glass; bottle.Transparency=.25
   piece(tool,'Stopper',Vector3.new(.4,.25,.4),Vector3.new(0,1.5,0),Color3.fromRGB(147,114,65),handle)
  elseif key=='WoodenStake' then
   local stake=piece(tool,'AshwoodStake',Vector3.new(.35,2.4,.35),Vector3.new(0,1.2,0),Color3.fromRGB(119,78,43),handle)
   stake.Material=Enum.Material.Wood
  else
   for i=-1,1 do piece(tool,'Claw',Vector3.new(.12,1.6,.12),Vector3.new(i*.3,1.1,0),Color3.fromRGB(149,72,108),handle) end
  end
  tool.Parent=pack
 end
end
return Weapons
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1463">
      <Properties>
        <string name="Name">AdventureRules</string>
        <ProtectedString name="Source">-- Pure rules shared by server progression and deterministic tests.
local Rules={}
function Rules.ContractExpired(started,now)
 return started~=nil and now-started&gt;=180
end
function Rules.CanDeliver(started,now,packages)
 return started~=nil and not Rules.ContractExpired(started,now) and packages&gt;=3
end
function Rules.CanRitual(clue,night,now,readyAt)
 return clue==true and night==true and now&gt;=(readyAt or 0)
end
return Rules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1464">
      <Properties>
        <string name="Name">BotRules</string>
        <ProtectedString name="Source">local Rules={}
function Rules.Count(value)
 if type(value)~='number' or value~=value or value==math.huge or value==-math.huge then return nil end
 if value%1~=0 or value&lt;0 or value&gt;12 then return nil end
 return value
end
function Rules.Action(vampire,targetVampire,phase,revealed,weakened,infections,health)
 if phase=='Zi' then
  if vampire then return nil end
  return targetVampire and revealed and 'Capture' or 'Inspect'
 end
 if phase~='Noapte' or vampire==targetVampire then return nil end
 if vampire then
  if infections&gt;0 then return 'Infect' end
  if health&lt;65 then return 'Feed' end
  return 'Weapon'
 end
 return weakened and 'Capture' or 'Weapon'
end
return Rules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1465">
      <Properties>
        <string name="Name">Bots</string>
        <ProtectedString name="Source">-- Studio-only NPC participants. They call the actual round action handler.
local Players=game:GetService('Players')
local RunService=game:GetService('RunService')
local Pathfinding=game:GetService('PathfindingService')
local Rules=require(script.Parent.BotRules)
local Bots={actors={},paths={}}
local names={'Mira','Radu','Ana','Luca','Ilinca','Matei','Daria','Vlad','Sofia','Andrei','Elena','Toma'}
local function rig(index)
 local model=Instance.new('Model'); model.Name='BOT '..names[index]
 local function part(name,size,position,visible)
  local p=Instance.new('Part'); p.Name=name; p.Size=size; p.Position=position
  p.Color=name=='Head' and Color3.fromRGB(195,163,130) or Color3.fromRGB(75+index*5,89,102)
  p.CanCollide=name=='Torso'; p.CanTouch=false; p.Transparency=visible and 0 or 1; p.Parent=model
  return p
 end
 local root=part('HumanoidRootPart',Vector3.new(2,2,1),Vector3.zero,false)
 local torso=part('Torso',Vector3.new(2,2,1),Vector3.zero,true)
 local function joint(name,a,b,offset)
  local m=Instance.new('Motor6D'); m.Name=name; m.Part0=a; m.Part1=b; m.C0=CFrame.new(offset); m.Parent=a
 end
 joint('RootJoint',root,torso,Vector3.zero)
 joint('Neck',torso,part('Head',Vector3.new(2,1,1),Vector3.new(0,1.5,0),true),Vector3.new(0,1.5,0))
 for _,side in ipairs({-1,1}) do
  joint(side&lt;0 and 'Left Shoulder' or 'Right Shoulder',torso,part(side&lt;0 and 'Left Arm' or 'Right Arm',Vector3.new(1,2,1),Vector3.new(side*1.5,0,0),true),Vector3.new(side*1.5,0,0))
  joint(side&lt;0 and 'Left Hip' or 'Right Hip',torso,part(side&lt;0 and 'Left Leg' or 'Right Leg',Vector3.new(1,2,1),Vector3.new(side*.5,-2,0),true),Vector3.new(side*.5,-2,0))
 end
 local hum=Instance.new('Humanoid'); hum.DisplayName=model.Name; hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.Viewer; hum.Parent=model
 model.PrimaryPart=root; model:SetAttribute('ActorId',-index)
 return model
end
function Bots.Resolve(id) return Bots.actors[id] end
function Bots.SetCount(count,join,remove)
 if not RunService:IsStudio() or Rules.Count(count)==nil then return false end
 workspace:SetAttribute('ApusBotsConfiguring',true)
 workspace:SetAttribute('ApusBotCount',count)
 local folder=workspace:FindFirstChild('ApusBots')
 if not folder then folder=Instance.new('Folder'); folder.Name='ApusBots'; folder.Parent=workspace end
 for id,actor in pairs(Bots.actors) do
  remove(actor); actor.Character:Destroy(); actor.signal:Destroy(); Bots.actors[id]=nil; Bots.paths[id]=nil
 end
 for i=1,count do
  local model=rig(i); model.Parent=folder; model:PivotTo(CFrame.new(i*5-30,5,-20))
  model.HumanoidRootPart:SetNetworkOwner(nil)
  local signal=Instance.new('BindableEvent')
  local actor={IsBot=true,UserId=-i,Name=model.Name,DisplayName=model.Name,Character=model,Parent=Players,signal=signal,CharacterAdded=signal.Event}
  function actor:GetAttribute(k) return self.Character:GetAttribute(k) end
  function actor:SetAttribute(k,v) self.Character:SetAttribute(k,v) end
  function actor:LoadCharacterAsync()
   local old=self.Character
   self.Character=rig(i); self.Character.Parent=folder; self.Character:PivotTo(CFrame.new(0,5,-20))
   self.Character.HumanoidRootPart:SetNetworkOwner(nil)
   old:Destroy(); self.signal:Fire(self.Character)
  end
  Bots.actors[-i]=actor; join(actor)
  task.wait()
 end
 workspace:SetAttribute('ApusBotCount',count)
 workspace:SetAttribute('ApusBotsConfiguring',false)
 return true
end
function Bots.Start(states,getPhase,act,alive,root)
 if not RunService:IsStudio() then return end
 task.spawn(function()
  while true do
   task.wait(.5)
   for id,p in pairs(Bots.actors) do
    local s=states[p]
    if s and alive(p) and not workspace:GetAttribute('ApusBotsPaused') then
     local nearest,distance=nil,math.huge
     local phase=getPhase()
     for target,t in pairs(states) do
      if target~=p and alive(target) and (phase=='Zi' or s.vampire~=t.vampire) then
       local d=(root(p).Position-root(target).Position).Magnitude
       if d&lt;distance then nearest=target; distance=d end
      end
     end
     if nearest then
      local r,goal=root(p),root(nearest).Position
      local h=p.Character.Humanoid
      local destination=goal
      if phase=='Zi' and s.vampire then
       local away=r.Position-goal
       destination=r.Position+(away.Magnitude&gt;.1 and away.Unit or Vector3.new(1,0,0))*20
      end
      if distance&gt;6 then
       local path=Bots.paths[id]
       if not path or os.clock()&gt;=path.at then
        path={at=os.clock()+3}; Bots.paths[id]=path
        local route=Pathfinding:CreatePath({AgentRadius=2,AgentHeight=5,AgentCanJump=true,WaypointSpacing=6})
        local ok=pcall(function() route:ComputeAsync(r.Position,destination) end)
        if ok and route.Status==Enum.PathStatus.Success then path.points=route:GetWaypoints(); path.index=2 end
       end
       local point=path.points and path.points[path.index]
       if point then
        if (r.Position-point.Position).Magnitude&lt;4 then path.index=path.index+1 end
        h:MoveTo(point.Position); if point.Action==Enum.PathWaypointAction.Jump then h.Jump=true end
       else h:MoveTo(destination) end
      elseif (goal-r.Position).Magnitude&gt;.1 then
       h:MoveTo(r.Position); p.Character:PivotTo(CFrame.lookAt(r.Position,Vector3.new(goal.X,r.Position.Y,goal.Z)))
      end
      local t=states[nearest]
      local kind=Rules.Action(s.vampire,t.vampire,phase,(t.reveal or 0)&gt;os.clock(),(t.weakened or 0)&gt;os.clock(),s.infections,h.Health)
      if kind and distance&lt;=(kind=='Weapon' and 8 or 10) then act(p,kind,nearest.UserId) end
     end
    end
   end
  end
 end)
end
return Bots
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1466">
      <Properties>
        <string name="Name">Sessions</string>
        <ProtectedString name="Source">-- Private-session routing. Access tokens stay server-side; clients receive short join codes.
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService')
local Teleport=game:GetService('TeleportService')
local Memory=game:GetService('MemoryStoreService')
local Http=game:GetService('HttpService')
local Rules=require(script.Parent.SessionRules)
local BotRules=require(script.Parent.BotRules)
local Sessions={}
function Sessions.Init(setBots)
 local request=Instance.new('RemoteFunction'); request.Name='ApusSessions'; request.Parent=RS
 local last,busy,created={},{},{}
 local map=not RunService:IsStudio() and game.PlaceId&gt;0 and Memory:GetHashMap('ApusSessions_v1') or nil
 local function teleport(p,entry)
  local options=Instance.new('TeleportOptions'); options.ReservedServerAccessCode=entry.access
  options:SetTeleportData({apusCode=entry.code})
  Teleport:TeleportAsync(game.PlaceId,{p},options)
 end
 request.OnServerInvoke=function(p,kind,value)
  if type(kind)~='string' then return {ok=false,message='Invalid request.'} end
  if kind=='Info' then return {ok=true,studio=RunService:IsStudio(),code=p:GetAttribute('ApusJoinCode') or '',bots=workspace:GetAttribute('ApusBotCount') or 0} end
  if busy[p] or os.clock()&lt;(last[p] or 0) then return {ok=false,message='Please wait a few seconds.'} end
  last[p]=os.clock()+5; busy[p]=true
  local ok,result=pcall(function()
   if kind=='Bots' then
    local count=BotRules.Count(value)
    if count==nil then return {ok=false,message='Choose between 0 and 12 bots.'} end
    local success,message=setBots(count); return {ok=success,message=message}
   end
   if kind~='Host' and kind~='Join' then return {ok=false,message='Unknown request.'} end
   if not map then return {ok=false,message='Host / Join requires a published experience and the Roblox app. In Studio, use bots or Server &amp; Clients.'} end
   local entry
   if kind=='Host' then
    entry=created[p]
    if not entry or os.time()&gt;=entry.expires then
     local access,privateId=Teleport:ReserveServerAsync(game.PlaceId)
     -- Atomic reservation prevents accidental overwriting of an existing invite code.
     for _=1,4 do
      local code=Http:GenerateGUID(false):gsub('-',''):sub(1,8):upper()
      local candidate={code=code,access=access,privateId=privateId,expires=os.time()+7200}
      local chosen=map:UpdateAsync(code,function(old) return old or candidate end,7200)
      if chosen and chosen.access==access then entry=candidate; break end
     end
     assert(entry,'Unable to allocate session code')
     created[p]=entry
    end
   else
    local code=Rules.Code(value)
    if not code then return {ok=false,message='The code must have 8 characters (0-9 / A-F).'} end
    entry=map:GetAsync(code)
    if type(entry)~='table' or type(entry.access)~='string' or type(entry.expires)~='number' or entry.expires&lt;=os.time() then
     return {ok=false,message='Invalid or expired code (2 hours).'}
    end
   end
   p:SetAttribute('ApusJoinCode',entry.code)
   teleport(p,entry)
   return {ok=true,message='Joining session. Code: '..entry.code,code=entry.code}
  end)
  busy[p]=nil
  if not ok then return {ok=false,message='Connection failed. Try again; your hosted session keeps the same code.'} end
  return result
 end
 Teleport.TeleportInitFailed:Connect(function(p)
  busy[p]=nil; p:SetAttribute('ApusSessionError','Teleport failed. Try again from the Multiplayer menu.')
 end)
 local function arriving(p)
  if not map then return end
  -- TeleportData is untrusted. Only show codes backed by this server's actual reservation.
  local data=p:GetJoinData().TeleportData
  local code=type(data)=='table' and Rules.Code(data.apusCode)
  if code and game.PrivateServerId~='' then
   local ok,entry=pcall(function() return map:GetAsync(code) end)
   if ok and type(entry)=='table' and entry.privateId==game.PrivateServerId then p:SetAttribute('ApusJoinCode',code) end
  end
 end
 Players.PlayerAdded:Connect(function(p) task.spawn(arriving,p) end)
 for _,p in ipairs(Players:GetPlayers()) do task.spawn(arriving,p) end
 Players.PlayerRemoving:Connect(function(p) last[p]=nil; busy[p]=nil; created[p]=nil end)
end
return Sessions
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1467">
      <Properties>
        <string name="Name">SessionRules</string>
        <ProtectedString name="Source">local Rules={}
function Rules.Code(value)
 if type(value)~='string' or #value&gt;24 then return nil end
 local code=value:upper():gsub('%s','')
 if #code~=8 or not code:match('^[A-F0-9]+$') then return nil end
 return code
end
return Rules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1468">
      <Properties>
        <string name="Name">HuntRules</string>
        <ProtectedString name="Source">local Rules={}
function Rules.Support(humanScore,vampireScore)
 if vampireScore&gt;humanScore then return 'Priest' end
 if humanScore&gt;vampireScore then return 'Bat' end
 return 'None'
end
function Rules.InSanctuary(x,y,z)
 return x&gt;=44 and x&lt;=66 and y&gt;=0 and y&lt;=23 and z&gt;=-166 and z&lt;=-134
end
function Rules.Protected(vampire,x,y,z)
 return not vampire and Rules.InSanctuary(x,y,z)
end
function Rules.StakeFinishes(phase,health,revealed,weakened)
 return health&lt;=25 or weakened or (phase=='Zi' and revealed)
end
return Rules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1469">
      <Properties>
        <string name="Name">CharacterDesign</string>
        <ProtectedString name="Source">-- Original role silhouettes; concealed vampires retain the common daytime outfit.
local Design={}
local original=setmetatable({},{__mode='k'})
function Design.Apply(char,vampire)
 local style=vampire and 'Vampire' or 'Hunter'
 if char:GetAttribute('ApusOutfitStyle')==style then return end
 local torso=char:FindFirstChild('UpperTorso') or char:FindFirstChild('Torso')
 local head=char:FindFirstChild('Head')
 if not torso or not head then return end
 local old=char:FindFirstChild('ApusOutfit'); if old then old:Destroy() end
 local outfit=Instance.new('Model'); outfit.Name='ApusOutfit'; outfit.Parent=char
 if not original[head] then original[head]=head.Color end
 head.Color=vampire and Color3.fromRGB(190,196,204) or original[head]
 local function piece(name,anchor,size,offset,color)
  local p=Instance.new('Part'); p.Name=name; p.Size=size; p.Material=Enum.Material.Fabric; p.Color=color
  p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.Massless=true; p.CastShadow=false
  p.CFrame=anchor.CFrame*CFrame.new(offset); p.Parent=outfit
  local weld=Instance.new('WeldConstraint'); weld.Part0=anchor; weld.Part1=p; weld.Parent=p
  return p
 end
 local width=torso.Size.X
 piece('Tunic',torso,Vector3.new(width+.1,torso.Size.Y*.85,torso.Size.Z+.1),Vector3.zero,
  vampire and Color3.fromRGB(42,28,43) or Color3.fromRGB(49,68,82))
 piece('LeatherBelt',torso,Vector3.new(width+.18,.22,torso.Size.Z+.18),Vector3.new(0,-torso.Size.Y*.32,0),Color3.fromRGB(94,64,40))
 if vampire then
  piece('CrimsonMantle',torso,Vector3.new(width+1.1,.35,torso.Size.Z+.45),Vector3.new(0,torso.Size.Y*.4,.1),Color3.fromRGB(105,25,39))
  piece('CrimsonCape',torso,Vector3.new(width+.5,torso.Size.Y*1.5,.18),Vector3.new(0,-.55,torso.Size.Z/2+.25),Color3.fromRGB(88,20,34))
  for _,side in ipairs({-1,1}) do
   local eye=piece('RedEye',head,Vector3.new(.16,.1,.04),Vector3.new(side*.25,.08,-head.Size.Z/2-.02),Color3.fromRGB(160,32,39)); eye.Material=Enum.Material.SmoothPlastic
   piece('Fang',head,Vector3.new(.09,.14,.07),Vector3.new(side*.15,-.23,-head.Size.Z/2-.04),Color3.fromRGB(227,222,203))
  end
 else
  piece('HunterShoulder',torso,Vector3.new(.5,.3,torso.Size.Z+.25),Vector3.new(width*.4,torso.Size.Y*.42,0),Color3.fromRGB(104,79,47))
  local badge=piece('SilverInsignia',torso,Vector3.new(.28,.4,.08),Vector3.new(-width*.28,.15,-torso.Size.Z/2-.1),Color3.fromRGB(179,189,192)); badge.Material=Enum.Material.Metal
 end
 char:SetAttribute('ApusOutfitStyle',style)
end
return Design
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1470">
      <Properties>
        <string name="Name">WorldLife</string>
        <ProtectedString name="Source">-- Bounded shared updates: ten wildlife models, at most three hostile helpers.
local Pathfinding=game:GetService('PathfindingService')
local Hunt=require(script.Parent.HuntRules)
local Life={actors={},support='None',phase='Asteptare'}
local ctx,creatures,scenery
local fauna={}
local function model(name,kind)
 local m=Instance.new('Model'); m.Name=name; m:SetAttribute('CreatureKind',kind)
 local root=Instance.new('Part'); root.Name='HumanoidRootPart'; root.Size=Vector3.new(1,1,1); root.Transparency=1
 root.Anchored=true; root.CanCollide=false; root.CanTouch=false; root.CanQuery=false; root.Parent=m; m.PrimaryPart=root
 local function part(name,size,pos,color,cls)
  local p=Instance.new(cls or 'Part'); p.Name=name; p.Size=size; p.CFrame=CFrame.new(pos); p.Color=color
  p.Material=Enum.Material.SmoothPlastic; p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.CastShadow=false; p.Parent=m
  return p
 end
 local coat=kind=='NightHound' and Color3.fromRGB(48,47,60) or Color3.fromRGB(128,92,58)
 if kind=='Bat' then
  part('Body',Vector3.new(.8,1.1,.8),Vector3.zero,Color3.fromRGB(54,30,47))
  for _,side in ipairs({-1,1}) do
   part('Wing',Vector3.new(2.3,.15,1.8),Vector3.new(side*1.35,0,0),Color3.fromRGB(89,32,48),'WedgePart')
   part('Ear',Vector3.new(.22,.6,.3),Vector3.new(side*.27,.7,0),Color3.fromRGB(61,33,48))
   part('Eye',Vector3.new(.09,.09,.05),Vector3.new(side*.18,.2,-.43),Color3.fromRGB(191,49,49))
  end
 elseif kind=='Priest' then
  part('Robe',Vector3.new(2.1,3,1.1),Vector3.new(0,-.35,0),Color3.fromRGB(224,214,181))
  part('Stole',Vector3.new(.65,2.9,1.18),Vector3.new(0,-.3,0),Color3.fromRGB(75,57,93))
  part('Head',Vector3.new(1.5,1.3,1.2),Vector3.new(0,1.8,0),Color3.fromRGB(191,159,129))
  part('Beard',Vector3.new(1,.6,.22),Vector3.new(0,1.3,-.67),Color3.fromRGB(186,184,175))
  part('Cross',Vector3.new(.15,.75,.1),Vector3.new(0,.4,-.65),Color3.fromRGB(187,158,85))
  part('CrossArm',Vector3.new(.5,.12,.1),Vector3.new(0,.55,-.65),Color3.fromRGB(187,158,85))
 elseif kind=='Chicken' then
  part('Body',Vector3.new(.9,.8,1.1),Vector3.zero,Color3.fromRGB(207,192,161))
  part('Head',Vector3.new(.5,.6,.5),Vector3.new(0,.5,-.5),Color3.fromRGB(222,211,184))
  part('Comb',Vector3.new(.15,.25,.35),Vector3.new(0,.9,-.5),Color3.fromRGB(154,48,43))
  part('Beak',Vector3.new(.3,.2,.35),Vector3.new(0,.5,-.8),Color3.fromRGB(192,146,56))
  for _,s in ipairs({-1,1}) do part('Leg',Vector3.new(.12,.6,.12),Vector3.new(s*.25,-.6,0),Color3.fromRGB(192,146,56)) end
 else
  local rabbit=kind=='Rabbit'
  local scale=rabbit and .5 or 1
  part('Body',Vector3.new(1.4,1.4,2.4)*scale,Vector3.zero,coat)
  part('Head',Vector3.new(.9,1,1.1)*scale,Vector3.new(0,.45,-1.35)*scale,coat)
  for _,s in ipairs({-1,1}) do
   part('Eye',Vector3.new(.1,.1,.12),Vector3.new(s*.38,.65,-1.86)*scale,kind=='NightHound' and Color3.fromRGB(155,48,51) or Color3.fromRGB(35,28,25))
   part('Ear',Vector3.new(.2,rabbit and 1.3 or .6,.35)*scale,Vector3.new(s*.3,1.1,-1.4)*scale,coat)
   for _,z in ipairs({-.75,.75}) do part('Leg',Vector3.new(.3,1.4,.4)*scale,Vector3.new(s*.5,-1.2,z)*scale,coat) end
  end
  part('Tail',Vector3.new(.3,.3,1)*scale,Vector3.new(0,.2,1.5)*scale,coat)
  if kind=='Deer' then
   for _,s in ipairs({-1,1}) do part('Antler',Vector3.new(.15,1.1,.15),Vector3.new(s*.3,1.6,-1.25),Color3.fromRGB(162,145,110)) end
  end
 end
 return m
end
local function clearHelpers()
 for id,a in pairs(Life.actors) do ctx.remove(a); a.Character:Destroy(); Life.actors[id]=nil end
 if Life.priest then Life.priest:Destroy(); Life.priest=nil end
end
local function spawnHostile(id,kind,pos)
 local m=model(kind=='Bat' and 'Crimson Bat' or 'Night Hound',kind)
 local hum=Instance.new('Humanoid'); hum.RequiresNeck=false; hum.BreakJointsOnDeath=false; hum.MaxHealth=kind=='Bat' and 60 or 70; hum.Health=hum.MaxHealth; hum.DisplayName=m.Name; hum.Parent=m
 m:SetAttribute('ActorId',id); m:SetAttribute('RoundActive',true); m:SetAttribute('Captured',false); m.Parent=creatures; m:PivotTo(CFrame.new(pos))
 local actor={IsBot=true,IsCreature=true,UserId=id,Name=m.Name,DisplayName=m.Name,Character=m,Parent=game.Players,kind=kind,nextHit=0}
 function actor:GetAttribute(k) return self.Character:GetAttribute(k) end
 function actor:SetAttribute(k,v) self.Character:SetAttribute(k,v) end
 Life.actors[id]=actor; ctx.register(actor)
end
function Life.Resolve(id) return Life.actors[id] end
function Life.Defeat(actor)
 if Life.actors[actor.UserId] then ctx.remove(actor); Life.actors[actor.UserId]=nil; actor.Character:Destroy() end
end
function Life.BeginRound(scores)
 Life.support=Hunt.Support(scores.humans,scores.vampires)
 workspace:SetAttribute('ApusSupport',Life.support)
end
function Life.OnPhase(phase)
 Life.phase=phase; clearHelpers()
 if phase~='Zi' and phase~='Noapte' then return end
 if Life.support=='Priest' then
  Life.priest=model('Father Alden','Priest'); Life.priest.Parent=scenery; Life.priest:PivotTo(CFrame.new(55,2.5,-148)); Life.nextHeal=0
  local b=Instance.new('BillboardGui'); b.Size=UDim2.fromOffset(160,32); b.StudsOffset=Vector3.new(0,4,0); b.MaxDistance=50; b.Parent=Life.priest.PrimaryPart
  local t=Instance.new('TextLabel'); t.Size=UDim2.fromScale(1,1); t.BackgroundTransparency=1; t.Text='FATHER ALDEN\nHealing nearby humans'; t.TextColor3=Color3.fromRGB(238,220,168); t.TextSize=12; t.Parent=b
 end
 if phase=='Noapte' then
  spawnHostile(-1001,'NightHound',Vector3.new(-95,2,-75))
  spawnHostile(-1002,'NightHound',Vector3.new(95,2,75))
  if Life.support=='Bat' then spawnHostile(-1003,'Bat',Vector3.new(0,12,-80)) end
 end
end
function Life.Init(context)
 ctx=context
 creatures=Instance.new('Folder'); creatures.Name='ApusCreatures'; creatures.Parent=workspace
 scenery=Instance.new('Folder'); scenery.Name='ApusWildlife'; scenery.Parent=workspace
 for i=1,10 do
  local kind=i&lt;=3 and 'Deer' or i&lt;=6 and 'Rabbit' or 'Chicken'
  local pos=i&lt;=3 and Vector3.new(-340+i*20,2,210) or i&lt;=6 and Vector3.new(185+(i-3)*9,1,190) or Vector3.new(200+(i-6)*7,1,160)
  local m=model(kind,kind); m.Parent=scenery; m:PivotTo(CFrame.new(pos)); table.insert(fauna,{model=m,home=pos,index=i})
 end
 task.spawn(function()
  local tick=0
  while true do
   task.wait(.5); tick=tick+1
   if tick%4==0 then
    for _,a in ipairs(fauna) do
     local now=os.clock()*.1+a.index
     local pos=a.home+Vector3.new(math.sin(now)*5,0,math.cos(now*.8)*5)
     a.model:PivotTo(CFrame.new(pos)*CFrame.Angles(0,now,0))
    end
   end
   if Life.priest and os.clock()&gt;=(Life.nextHeal or 0) then
    Life.nextHeal=os.clock()+8
    for p,s in pairs(ctx.states) do if not s.vampire and not s.creature and ctx.alive(p) and (ctx.root(p).Position-Life.priest:GetPivot().Position).Magnitude&lt;=20 then
     local h=p.Character:FindFirstChildOfClass('Humanoid'); h.Health=math.min(h.MaxHealth,h.Health+12)
    end end
   end
   for _,a in pairs(Life.actors) do
    if os.clock()&gt;=(a.stunnedUntil or 0) then
     local r=a.Character.PrimaryPart; local nearest,distance=nil,120
     for p,s in pairs(ctx.states) do
      if not s.vampire and not s.creature and ctx.alive(p) and not ctx.protected(p) then
       local d=(ctx.root(p).Position-r.Position).Magnitude
       if d&lt;distance then nearest=p; distance=d end
      end
     end
     if nearest then
      local target=ctx.root(nearest).Position; local goal=target+Vector3.new(0,a.kind=='Bat' and 8 or -1,0)
      if a.kind~='Bat' then
       if not a.routeAt or os.clock()&gt;=a.routeAt then
        a.routeAt=os.clock()+3
        local path=Pathfinding:CreatePath({AgentRadius=2,AgentHeight=4,AgentCanJump=false})
        local ok=pcall(function() path:ComputeAsync(r.Position,target) end)
        a.points=ok and path.Status==Enum.PathStatus.Success and path:GetWaypoints() or nil; a.index=2
       end
       local point=a.points and a.points[a.index]
       if point then
        goal=point.Position+Vector3.new(0,2,0)
        if (goal-r.Position).Magnitude&lt;3 then a.index=a.index+1 end
       end
      end
      local delta=goal-r.Position
      if delta.Magnitude&gt;.3 then
       local pos=r.Position+delta.Unit*math.min(delta.Magnitude,(a.kind=='Bat' and 14 or 12)*.5)
       local facing=Vector3.new(delta.X,0,delta.Z)
       if Life.actors[a.UserId]==a and not Hunt.InSanctuary(pos.X,pos.Y,pos.Z) and facing.Magnitude&gt;.01 then a.Character:PivotTo(CFrame.lookAt(pos,pos+facing)) end
      end
      local range=a.kind=='Bat' and 12 or 6
      if Life.actors[a.UserId]==a and Life.phase=='Noapte' and ctx.alive(nearest) and not ctx.protected(nearest) and (ctx.root(nearest).Position-r.Position).Magnitude&lt;=range and os.clock()&gt;=a.nextHit then
       target=ctx.root(nearest).Position
       local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude; ray.FilterDescendantsInstances={a.Character,nearest.Character}
       if not workspace:Raycast(r.Position,target-r.Position,ray) then
        a.nextHit=os.clock()+(a.kind=='Bat' and 5 or 6); ctx.hurt(nearest,a.kind=='Bat' and 8 or 5)
       end
      end
     end
    end
   end
  end
 end)
end
return Life
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX1471">
      <Properties>
        <string name="Name">Game</string>
        <ProtectedString name="Source">-- Satul dupa Apus: server-authoritative prototype. No external assets.
local Players = game:GetService('Players')
local RS = game:GetService('ReplicatedStorage')
local Lighting = game:GetService('Lighting')
local TweenService=game:GetService('TweenService')
local Combat=require(RS:WaitForChild('CombatRules'))
local Weapons=require(script.Parent.Weapons)
local Bots=require(script.Parent.Bots)
local Sessions=require(script.Parent.Sessions)
local Hunt=require(script.Parent.HuntRules)
local Design=require(script.Parent.CharacterDesign)
local Life=require(script.Parent.WorldLife)
local RunService=game:GetService('RunService')
local function isBot(p) return type(p)=='table' and p.IsBot==true end
local function emit(remote,p,data) if not isBot(p) then remote:FireClient(p,data) end end
local net = Instance.new('Folder'); net.Name = 'ApusNet'; net.Parent = RS
local action = Instance.new('RemoteEvent'); action.Name = 'Action'; action.Parent = net
local status = Instance.new('RemoteEvent'); status.Name = 'Status'; status.Parent = net
local feedback=Instance.new('RemoteEvent'); feedback.Name='Feedback'; feedback.Parent=net
local C=require(script.Parent.Config)
local Rules=require(script.Parent.Rules)
local RPG=require(script.Parent.Progression)
local Monetization=require(script.Parent.Monetization)
Monetization.Init()
local states = {}
local phase, remaining, cycle, running, roundId = 'Asteptare', 0, 0, false, 0
local setPhase
local practiceRound=false
local pendingBotCount=nil
local scores={humans=0,vampires=0}
local practiceScores={humans=0,vampires=0}
local message = 'At least two participants are required.'
local spawns = workspace:WaitForChild('Village'):WaitForChild('Spawns'):GetChildren()
table.sort(spawns,function(a,b) return tonumber(a.Name:match('%d+'))&lt;tonumber(b.Name:match('%d+')) end)
local cryptFolder=workspace.Village:WaitForChild('Crypts')
local crypts=cryptFolder:GetChildren()
table.sort(crypts,function(a,b) return a.Name&lt;b.Name end)
local activeCrypts=1
local cryptVisuals={}
local lobby = workspace.Village.LobbyPoint
local function root(p) return p.Character and p.Character:FindFirstChild('HumanoidRootPart') end
local function humanoid(p) return p.Character and p.Character:FindFirstChildOfClass('Humanoid') end
local function alive(p)
 local s=states[p]; local h=humanoid(p)
 return s and s.active and not s.captured and h and h.Health&gt;0 and root(p)
end
local function move(p, pos)
 local r=root(p); if r then p.Character:PivotTo(CFrame.new(pos)) end
end
local function tell(p,t) local s=states[p]; if s then s.notice=t; s.noticeUntil=os.clock()+5 end end
local function protected(p)
 local s,r=states[p],root(p)
 return s and not s.captured and r and Hunt.Protected(s.vampire,r.Position.X,r.Position.Y,r.Position.Z)
end
local function paint(p)
 local s=states[p]; if not s or not p.Character then return end
 if s.creature then return end
 Design.Apply(p.Character,s.vampire and s.active and (phase=='Noapte' or s.captured or (s.reveal or 0)&gt;os.clock()))
 p:SetAttribute('RoundActive',s.active); p:SetAttribute('Captured',s.captured)
 local old=p.Character:FindFirstChild('Revealed'); if old then old:Destroy() end
 if s.active and not s.captured and s.vampire and (phase=='Noapte' or (s.reveal or 0)&gt;os.clock()) then
  local h=Instance.new('Highlight'); h.Name='Revealed'; h.FillColor=Color3.fromRGB(155,20,55)
  h.FillTransparency=0.6; h.OutlineColor=Color3.fromRGB(255,90,95)
  h.DepthMode=Enum.HighlightDepthMode.Occluded; h.Parent=p.Character
 end
 local pr=root(p); if pr then pr.Anchored=s.captured end
 local hum=humanoid(p)
 if hum then
  local stopped=s.captured or (s.stunnedUntil or 0)&gt;os.clock()
  hum.WalkSpeed=(stopped and 0) or ((s.weakened or 0)&gt;os.clock() and 10) or (phase=='Noapte' and s.vampire and s.active and 20) or 16
  hum.JumpPower=stopped and 0 or 50; hum.JumpHeight=stopped and 0 or 7.2
 end
end
local function counts()
 local humans,vamps=0,0
 for p,s in pairs(states) do if s.active and not s.creature and not s.captured and p.Parent==Players then
  if s.vampire then vamps=vamps+1 else humans=humans+1 end
 end end
 return humans,vamps
end
local function winner()
 local h,v=counts()
 if v==0 then return 'Villagers win: all vampires have been captured.' end
 if h==0 then return 'Vampires win: the village has fallen.' end
 return nil
end
local function validTarget(p, id, range)
 if type(id)~='number' or id~=id or id==math.huge or id==-math.huge or id%1~=0 or math.abs(id)&gt;9007199254740991 then return nil end
 local target=id&lt;0 and (Bots.Resolve(id) or Life.Resolve(id)) or Players:GetPlayerByUserId(id)
 if not target or target==p or not alive(p) or not alive(target) then return nil end
 if protected(p) or protected(target) then return nil end
 local a,b=root(p),root(target)
 if (a.Position-b.Position).Magnitude&gt;(range or C.Range) then return nil end
 local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude
 ray.FilterDescendantsInstances={p.Character,target.Character}
 if workspace:Raycast(a.Position,b.Position-a.Position,ray) then return nil end
 return target
end
local function jailPosition(p)
 local s=states[p]; local index=s and s.jail or 1
 local point=crypts[math.clamp(index,1,activeCrypts)].JailPoint
 -- A fixed personal slot prevents up to ten captives occupying the same point.
 local slot=s and s.jailSlot or 0
 return point.Position+Vector3.new((slot%4-1.5)*6,3,(math.floor(slot/4)-1)*6)
end
local function assignJail(p)
 local prisoners={}
 for other,t in pairs(states) do
  if other~=p and t.active and t.captured then table.insert(prisoners,t) end
 end
 local jail,slot=Rules.JailSlot(prisoners,activeCrypts)
 states[p].jail=jail; states[p].jailSlot=slot
end
local function updateCrypts()
 local count=0
 for p,s in pairs(states) do if s.active and not s.creature and p.Parent==Players then count=count+1 end end
 local desired=Rules.CryptCount(count)
 activeCrypts=desired
 -- Move prisoners out before closing any occupied crypt.
 for p,s in pairs(states) do
  if s.active and s.captured and (not s.jail or s.jail&gt;desired) then
   assignJail(p); move(p,jailPosition(p))
  end
 end
 for i,crypt in ipairs(crypts) do
  local enabled=i&lt;=desired
  crypt:SetAttribute('Active',enabled)
  for _,obj in ipairs(crypt:GetDescendants()) do
   if obj:IsA('BasePart') then
    if not cryptVisuals[obj] then cryptVisuals[obj]={obj.Transparency,obj.CanCollide} end
    obj.Transparency=enabled and cryptVisuals[obj][1] or 1
    obj.CanCollide=enabled and cryptVisuals[obj][2] or false
   elseif obj:IsA('SurfaceGui') then obj.Enabled=enabled end
  end
 end
 workspace.Village:SetAttribute('ActiveCrypts',desired)
end
local function capture(target)
 local s=states[target]; s.captured=true; s.pending=false
 assignJail(target); move(target,jailPosition(target)); paint(target)
 tell(target,'Captured in crypt '..s.jail..' until the round ends.')
end
local function damageActor(target,amount)
 local s,h=states[target],humanoid(target)
 if not s or not h then return end
 if s.creature then
  h.Health=math.max(0,h.Health-amount)
  if h.Health&lt;=0 then Life.Defeat(target) end
  return
 end
 h.Health=Combat.HealthAfter(h.Health,amount)
 if s.vampire and amount&gt;0 and root(target) then
  feedback:FireAllClients({kind='VampireBlood',position=root(target).Position+Vector3.new(0,1,0)})
 end
 if h.Health&lt;=1 then
  s.weakened=os.clock()+8; s.reveal=os.clock()+8; paint(target)
  tell(target,'Weakened for 8 seconds. Escape or call for help!')
 end
end
Life.Init({states=states,root=root,alive=alive,protected=protected,hurt=damageActor,
 register=function(p) states[p]={active=true,vampire=true,creature=true,captured=false,cooldowns={},infections=0} end,
 remove=function(p) states[p]=nil end})
updateCrypts()
RPG.Init(function(p)
 local s=states[p]
 return s and not s.captured and phase~='Rezultat'
end)
local allowed={Inspect=true,Capture=true,Feed=true,Infect=true,Weapon=true}
local function handleAction(p, kind, id)
 local s=states[p]
 if not s or type(kind)~='string' or not allowed[kind] then return end
 local now=os.clock()
 if now&lt;(s.nextRequest or 0) then return end
 s.nextRequest=now+0.25
 if not running or (s.stunnedUntil or 0)&gt;now then return end
 local tool=p.Character and p.Character:FindFirstChildOfClass('Tool')
 local weaponKey=isBot(p) and (s.testWeapon or (s.vampire and 'Claws' or 'SilverSword')) or (tool and tool:GetAttribute('ApusWeapon'))
 local weapon=Combat.Weapons[weaponKey]
 if kind=='Weapon' and not weapon then return end
 local target=validTarget(p,id,kind=='Weapon' and weapon.range or C.Range); if not target then tell(p,'Approach a visible target within 10 studs.'); return end
 local t=states[target]
 if t.creature and kind~='Weapon' then return end
 local cd=kind=='Weapon' and weapon.cooldown or C[kind..'Cooldown']
 if now&lt;(s.cooldowns[kind] or 0) then tell(p,'Ability is on cooldown.'); return end
 if kind=='Weapon' then
  local a,b=root(p),root(target); local delta=b.Position-a.Position
  if delta.Magnitude&lt;.01 then return end
  local key=weaponKey
  if not Combat.CanHit(key,s.vampire,t.vampire,phase,delta.Magnitude,a.CFrame.LookVector:Dot(delta.Unit)) then return end
  s.cooldowns[kind]=now+cd
  if key=='Crucifix' then
   t.stunnedUntil=now+3; t.reveal=now+8
   if t.creature then target.stunnedUntil=now+3 else paint(target) end
   tell(p,'Consecrated light repels the vampire for 3 seconds.')
  elseif key=='WoodenStake' and not t.creature and Hunt.StakeFinishes(phase,humanoid(target).Health,(t.reveal or 0)&gt;now,(t.weakened or 0)&gt;now) then
   capture(target); tell(p,'Vampire subdued with the wooden stake.')
  else
   damageActor(target,weapon.damage)
   if key=='HolyWater' and states[target] then t.reveal=now+12; paint(target); tell(p,'Holy water exposes the vampire for 12 seconds.') end
  end
  emit(feedback,p,{kind='Hit',weapon=key,target=target.UserId})
  emit(feedback,target,{kind='Hurt'})
 elseif kind=='Inspect' then
  if s.vampire or phase~='Zi' then return end
  s.cooldowns[kind]=now+cd
  if t.vampire then t.reveal=now+15; paint(target); tell(p,'Vampire revealed! Capture them within 15 seconds.')
  elseif t.pending then tell(p,'The target is infected and transforms at the next dusk.')
  else tell(p,'The target is human.') end
 elseif kind=='Capture' then
  if s.vampire or (phase~='Zi' and not ((t.weakened or 0)&gt;now)) then return end
  s.cooldowns[kind]=now+cd
  if t.vampire and (t.reveal or 0)&gt;now then capture(target); tell(p,'Vampire captured in a crypt.')
  else tell(p,'You can only capture vampires revealed by investigation.') end
 elseif kind=='Feed' then
  if not s.vampire or phase~='Noapte' or t.vampire then return end
  s.cooldowns[kind]=now+cd
  local th=humanoid(target); local sh=humanoid(p)
  -- Nonlethal stylized feed: nobody is removed from play by health damage.
  th.Health=math.max(25,th.Health-20); sh.Health=math.min(sh.MaxHealth,sh.Health+25)
  tell(target,'A vampire fed on you! Seek safety with others.'); tell(p,'You recovered health.')
 elseif kind=='Infect' then
  if not s.vampire or phase~='Noapte' or t.vampire or t.pending or s.infections&lt;1 then return end
  s.cooldowns[kind]=now+cd; s.infections=s.infections-1; t.pending=true
  tell(target,'You are infected. You become a vampire at the next dusk.'); tell(p,'Infection successful. Transformation occurs at the next dusk.')
 end
end
action.OnServerEvent:Connect(handleAction)
local function attach(p,char)
 local h=char:WaitForChild('Humanoid',10); local r=char:WaitForChild('HumanoidRootPart',10)
 if not h or not r or not states[p] then return end
 local s=states[p]
 if s.active then
  if s.captured then move(p,jailPosition(p))
  else move(p,spawns[math.random(#spawns)].Position+Vector3.new(0,3,0)) end
 else move(p,lobby.Position+Vector3.new(0,3,0)) end
 paint(p)
 if not isBot(p) then Weapons.Give(p) end
 h.Died:Connect(function()
  if states[p] and running and states[p].active then
   -- Reset/death cannot erase infection or escape capture.
   capture(p)
  end
 end)
end
local function join(p)
 states[p]={active=false,vampire=false,captured=false,pending=false,cooldowns={},infections=0}
 p.CharacterAdded:Connect(function(char) attach(p,char) end)
 if p.Character then task.spawn(attach,p,p.Character) end
 if not isBot(p) then task.spawn(RPG.Join,p); Monetization.Join(p) end
end
Players.PlayerAdded:Connect(join)
Players.PlayerRemoving:Connect(function(p)
 states[p]=nil; updateCrypts(); RPG.Remove(p)
end)
for _,p in ipairs(Players:GetPlayers()) do join(p) end
Sessions.Init(function(count)
 if not RunService:IsStudio() then return false,'Test bots are available only in Studio.' end
 if running or phase~='Asteptare' then
  pendingBotCount=count; workspace:SetAttribute('ApusPendingBotCount',count)
  return true,'Setting '..count..' bots will apply after this round.'
 end
 Bots.SetCount(count,join,function(p) states[p]=nil end)
 updateCrypts()
 return true,'Bots: '..count..'. Practice rounds award no round rewards.'
end)
Bots.Start(states,function() return phase end,handleAction,alive,root)
-- Server-only test harness; never created in published servers or replicated to clients.
if RunService:IsStudio() then
 local probe=Instance.new('BindableFunction'); probe.Name='ApusStudioTest'; probe.Parent=game:GetService('ServerStorage')
 local function resolve(id) return id&lt;0 and (Bots.Resolve(id) or Life.Resolve(id)) or Players:GetPlayerByUserId(id) end
 probe.OnInvoke=function(kind,a,b)
  if kind=='Action' then
   local actor=resolve(a.actor); if actor then handleAction(actor,a.kind,a.target) end
  elseif kind=='Stage' then
   local actor,target=resolve(a),resolve(b)
   if actor and target then
    move(actor,Vector3.new(-100,4,0)); move(target,Vector3.new(-100,4,-5))
    local r=root(actor); if r then actor.Character:PivotTo(CFrame.lookAt(r.Position,root(target).Position)) end
   end
  elseif kind=='Bots' then
   if phase~='Asteptare' then return {error='Between rounds only'} end
   Bots.SetCount(a,join,function(p) states[p]=nil end)
  elseif kind=='Equip' then
   local actor=resolve(a); if actor and isBot(actor) and Combat.Weapons[b] then states[actor].testWeapon=b end
  elseif kind=='Health' then
   local actor=resolve(a); if actor and type(b)=='number' then humanoid(actor).Health=math.clamp(b,1,100) end
  elseif kind=='Position' then
   local actor=resolve(a); if actor and typeof(b)=='Vector3' then move(actor,b) end
  elseif kind=='Score' then
   practiceScores={humans=a,vampires=b}; Life.BeginRound(practiceScores); Life.OnPhase(phase)
  elseif kind=='Phase' and (a=='Zi' or a=='Noapte') then
   setPhase(a,20)
  end
  local result={phase=phase,round=roundId,practice=practiceRound,actors={},humans=0,vampires=0,support=Life.support}
  result.humans,result.vampires=counts()
  for p,s in pairs(states) do
   table.insert(result.actors,{id=p.UserId,bot=isBot(p),active=s.active,vampire=s.vampire,captured=s.captured,
    pending=s.pending,health=humanoid(p) and humanoid(p).Health,revealed=(s.reveal or 0)&gt;os.clock(),jail=s.jail,creature=s.creature,stunned=(s.stunnedUntil or 0)&gt;os.clock()})
  end
  return result
 end
end
local function readyRoster()
 local roster={}
 if workspace:GetAttribute('ApusBotsConfiguring') then return roster end
 for p in pairs(states) do
  local h=humanoid(p)
  if not states[p].creature and (isBot(p) or RPG.Ready(p)) and h and h.Health&gt;0 and root(p) then table.insert(roster,p) end
 end
 return roster
end
local function setSky(night)
 workspace:SetAttribute('ApusNight',night)
 TweenService:Create(Lighting,TweenInfo.new(4,Enum.EasingStyle.Sine),{
  ClockTime=night and 0 or 14.5,Brightness=night and 1.3 or 2.2,
  Ambient=night and Color3.fromRGB(76,83,116) or Color3.fromRGB(133,126,112),
  OutdoorAmbient=night and Color3.fromRGB(85,96,126) or Color3.fromRGB(145,151,163)
 }):Play()
end
setPhase=function(name,seconds)
 phase=name; remaining=seconds
 workspace:SetAttribute('ApusPhase',name)
 workspace:SetAttribute('ApusRoundId',roundId)
 setSky(name=='Noapte')
 Life.OnPhase(name)
 for p in pairs(states) do paint(p) end
end
local function waitPhase(seconds,check)
 for i=seconds,1,-1 do
  remaining=i
  if check then local result=winner(); if result then return result end end
  task.wait(1)
 end
 return check and winner() or nil
end
task.spawn(function()
 while true do
  for p,s in pairs(states) do
   local role='Explorator'
   if s.active then role=s.vampire and 'Vampir' or 'Satean' end
   local note=(s.noticeUntil or 0)&gt;os.clock() and s.notice or message
   if not isBot(p) then status:FireClient(p,{phase=phase,time=remaining,cycle=cycle,maxCycles=C.Cycles,role=role,
    captured=s.captured,pending=s.pending,active=s.active,notice=note,
    infections=s.infections,crypts=activeCrypts,night=workspace:GetAttribute('ApusNight'),practice=practiceRound,
    score=practiceRound and practiceScores or scores,support=Life.support,sanctuary=protected(p) and true or false,rpg=RPG.Snapshot(p)}) end
   if s.active and not s.creature and s.vampire and root(p) then
    local pos=root(p).Position
    if Hunt.InSanctuary(pos.X,pos.Y,pos.Z) then move(p,Vector3.new(55,4,-125)); tell(p,'Consecrated ground repels vampires.') end
   end
   if (s.stunnedUntil or 0)&gt;0 and s.stunnedUntil&lt;=os.clock() then s.stunnedUntil=0; paint(p) end
   if phase=='Zi' and (s.reveal or 0)&gt;0 and s.reveal&lt;=os.clock() then s.reveal=0; paint(p) end
   if (s.weakened or 0)&gt;0 and s.weakened&lt;=os.clock() then
    s.weakened=0; local h=humanoid(p); if h and h.Health&lt;=1 then h.Health=35 end; paint(p)
   end
  end
  task.wait(1)
 end
end)
while true do
 if pendingBotCount~=nil then
  Bots.SetCount(pendingBotCount,join,function(p) states[p]=nil end)
  pendingBotCount=nil; workspace:SetAttribute('ApusPendingBotCount',nil); updateCrypts()
 end
 running=false; practiceRound=false; cycle=0; setPhase('Asteptare',0)
 message='Enter the portal to explore. Inn contracts by day; monastery seal at night. PvP: 2+ participants.'
 local explorationTime=0
 local explorationDuration=C.Day
 repeat
  task.wait(1); explorationTime=explorationTime+1
  remaining=explorationDuration-explorationTime
  if explorationTime&gt;=explorationDuration then
   local night=not workspace:GetAttribute('ApusNight'); setSky(night)
   explorationTime=0; explorationDuration=night and C.Night or C.Day
  end
 until #readyRoster()&gt;=C.MinPlayers
 practiceRound=RunService:IsStudio() and (workspace:GetAttribute('ApusBotCount') or 0)&gt;0
 message=practiceRound and 'BOT PRACTICE - no round rewards.' or 'The round starts soon.'
 local preparation=practiceRound and 5 or C.Intermission
 setPhase('Pregatire',preparation); waitPhase(preparation,false)
 if #readyRoster()&gt;=C.MinPlayers then
  roundId=roundId+1
  local roster=readyRoster()
  while #roster&gt;C.MaxPlayers do table.remove(roster) end
  -- Fisher-Yates shuffle; 1 initial vampire per 10 players, maximum 5.
  for i=#roster,2,-1 do local j=math.random(i); roster[i],roster[j]=roster[j],roster[i] end
  local initialVampires=Rules.InitialVampires(#roster)
  for index,p in ipairs(roster) do
   local s=states[p]; s.active=true; s.vampire=(index&lt;=initialVampires); s.captured=false; s.pending=false
   s.cooldowns={}; s.infections=0; s.reveal=0; s.jail=nil; s.jailSlot=nil; s.weakened=0; s.stunnedUntil=0; s.testWeapon=nil
   local h=humanoid(p)
   if not h or h.Health&lt;=0 then p:LoadCharacterAsync() else
    h.Health=h.MaxHealth; move(p,practiceRound and Vector3.new(-70+(index-1)*9,4,-10) or spawns[index].Position+Vector3.new(0,3,0))
   end
  end
  updateCrypts()
  running=true
  Life.BeginRound(practiceRound and practiceScores or scores)
  local result=nil
  for n=1,C.Cycles do
   cycle=n; message='Day: investigate and capture revealed vampires.'
   local day=practiceRound and 20 or C.Day
   setPhase('Zi',day); result=waitPhase(day,true); if result then break end
   for p,s in pairs(states) do if s.active and not s.creature and not s.captured then
    if s.pending then s.vampire=true; s.pending=false; tell(p,'Transformation complete. You are a vampire!') end
    if s.vampire then s.infections=1 end
   end end
   message='Night: stay together. Vampires can hunt.'
   local night=practiceRound and 20 or C.Night
   setPhase('Noapte',night); result=waitPhase(night,true); if result then break end
  end
  running=false
  local humansLeft,vampiresLeft=counts()
  local vampireVictory=Rules.VampireVictory(humansLeft,vampiresLeft)
  local roundScores=practiceRound and practiceScores or scores
  if vampireVictory then roundScores.vampires=roundScores.vampires+1 else roundScores.humans=roundScores.humans+1 end
  for p,s in pairs(states) do
   if s.active and not isBot(p) and not practiceRound then RPG.RoundReward(p,s.vampire==vampireVictory) end
  end
  message=result or 'Villagers win: they survived all three nights.'
  setPhase('Rezultat',10); waitPhase(10,false)
  for p,s in pairs(states) do
   s.active=false; s.captured=false; s.pending=false; s.vampire=false; s.weakened=0; s.stunnedUntil=0
   paint(p); move(p,lobby.Position+Vector3.new(0,3,0))
  end
  updateCrypts()
 end
end
