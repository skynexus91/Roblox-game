    <Item class="ModuleScript" referent="RBX1473">
      <Properties>
        <string name="Name">MonetizationConfig</string>
        <ProtectedString name="Source">-- Create these passes under YOUR experience. Zero means disabled, never a test charge.
-- Prices are configured on Roblox and fetched dynamically by the client.
return {
 {key='GoldenLantern',id=0,title='Golden Lantern',description='Golden color with no range or power advantage.'},
 {key='MoonAura',id=0,title='Moon Aura',description='Blue cosmetic effect, independent of your role.'},
 {key='Supporter',id=0,title='Village Supporter',description='Cosmetic title above your character.'},
}
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1474">
      <Properties>
        <string name="Name">CombatRules</string>
        <ProtectedString name="Source">-- Pure combat rules. Values never come from the client.
local Combat={}
Combat.Weapons={
 SilverSword={name='Silver Sword',range=8,cooldown=1.0,damage=24,arc=.25,color={188,211,227}},
 Crossbow={name='Crossbow',range=45,cooldown=2.6,damage=16,arc=.80,color={109,75,48}},
 Claws={name='Claws',range=7,cooldown=1.2,damage=19,arc=.15,color={149,72,108}},
 Crucifix={name='Crucifix',range=12,cooldown=12,damage=0,arc=.3,day=true},
 HolyWater={name='Holy Water',range=18,cooldown=8,damage=18,arc=.5,day=true},
 WoodenStake={name='Wooden Stake',range=6,cooldown=2,damage=8,arc=.3,day=true},
}
function Combat.CanHit(key,attackerVampire,targetVampire,phase,distance,facing)
 local w=Combat.Weapons[key]
 if not w or (phase~='Noapte' and not (w.day and phase=='Zi')) or attackerVampire==targetVampire then return false end
 if (key=='Claws')~=attackerVampire then return false end
 return distance&lt;=w.range and facing&gt;=w.arc
end
-- Defeat disables temporarily; never resets a profile or erases infection.
function Combat.HealthAfter(health,damage) return math.max(1,health-damage) end
return Combat
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1475">
      <Properties>
        <string name="Name">Actors</string>
        <ProtectedString name="Source">-- Clients see public actor attributes, never the server's hidden role table.
local Players=game:GetService('Players')
local Actors={}
function Actors.List()
 local result=Players:GetPlayers()
 for _,folderName in ipairs({'ApusBots','ApusCreatures'}) do
 local folder=workspace:FindFirstChild(folderName)
 if folder then
  for _,model in ipairs(folder:GetChildren()) do
   local id=model:GetAttribute('ActorId')
   if type(id)=='number' and id&lt;0 then
    local actor={Character=model,UserId=id,DisplayName=model.Name}
    function actor:GetAttribute(key) return self.Character:GetAttribute(key) end
    table.insert(result,actor)
   end
  end
 end
 end
 return result
end
return Actors
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX1476">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX1477">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX1478">
        <Properties>
          <string name="Name">Controls</string>
          <ProtectedString name="Source">local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local CAS=game:GetService('ContextActionService')
local RunService=game:GetService('RunService')
local player=Players.LocalPlayer
local Actors=require(RS:WaitForChild('Actors'))
local net=RS:WaitForChild('ApusNet')
local action=net:WaitForChild('Action')
local status=net:WaitForChild('Status')
local gui=Instance.new('ScreenGui'); gui.Name='ApusHUD'; gui.ResetOnSpawn=false; gui.Parent=player:WaitForChild('PlayerGui')
local function label(name,pos,size,fontSize)
 local l=Instance.new('TextLabel'); l.Name=name; l.Position=pos; l.Size=size
 l.BackgroundColor3=Color3.fromRGB(18,19,29); l.BackgroundTransparency=0.15
 l.TextColor3=Color3.fromRGB(242,225,183); l.Font=Enum.Font.GothamMedium
 l.TextSize=fontSize; l.TextScaled=true; l.TextWrapped=true; l.Parent=gui
 local limit=Instance.new('UITextSizeConstraint'); limit.MinTextSize=10; limit.MaxTextSize=fontSize; limit.Parent=l
 local c=Instance.new('UICorner'); c.CornerRadius=UDim.new(0,9); c.Parent=l
 return l
end
local header=label('Phase',UDim2.fromScale(.2,.015),UDim2.fromScale(.6,.085),18)
local detail=label('Notice',UDim2.fromScale(.15,.105),UDim2.fromScale(.7,.11),15)
local targetLabel=label('Target',UDim2.fromScale(.25,.76),UDim2.fromScale(.5,.055),16)
local controls=label('Controls',UDim2.fromScale(.15,.82),UDim2.fromScale(.7,.07),13)
local statsLabel=label('RPGStats',UDim2.fromScale(.02,.23),UDim2.fromScale(.38,.07),15)
local questLabel=label('Quest',UDim2.fromScale(.02,.305),UDim2.fromScale(.38,.13),14)
local scoreLabel=label('TeamScore',UDim2.fromScale(.57,.30),UDim2.fromScale(.41,.08),14)
local data=nil
local phaseNames={Asteptare='Waiting',Pregatire='Preparation',Zi='Day',Noapte='Night',Rezultat='Results'}
local roleNames={Vampir='Vampire',Satean='Villager',Explorator='Explorer'}
local classNames={Vanator='Hunter',Cercetas='Scout',Carturar='Scholar'}
local selected=nil
local function nearest()
 local char=player.Character; local r=char and char:FindFirstChild('HumanoidRootPart')
 if not r then return nil end
 local candidates={}
 for _,p in ipairs(Actors.List()) do
  if p~=player and p.Character and p:GetAttribute('RoundActive') and not p:GetAttribute('Captured') then
   local pr=p.Character:FindFirstChild('HumanoidRootPart'); local h=p.Character:FindFirstChildOfClass('Humanoid')
   if pr and h and h.Health&gt;0 then
    local distance=(r.Position-pr.Position).Magnitude
    if distance&lt;=10 then table.insert(candidates,{p=p,root=pr,d=distance}) end
   end
  end
 end
 table.sort(candidates,function(a,b) return a.d&lt;b.d end)
 local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude
 for i=1,math.min(#candidates,8) do
  local c=candidates[i]; ray.FilterDescendantsInstances={char,c.p.Character}
  if not workspace:Raycast(r.Position,c.root.Position-r.Position,ray) then return c.p end
 end
 return nil
end
local function use(which)
 if not data or not data.active or data.captured or not selected then return end
 local kind
 if data.role=='Vampir' then kind=which==1 and 'Feed' or 'Infect'
 else kind=which==1 and 'Inspect' or 'Capture' end
 action:FireServer(kind,selected.UserId)
end
local function primary(_,state)
 if state==Enum.UserInputState.Begin then use(1) end
 return Enum.ContextActionResult.Sink
end
local function secondary(_,state)
 if state==Enum.UserInputState.Begin then use(2) end
 return Enum.ContextActionResult.Sink
end
local bound=false
local function bind(enabled)
 if enabled==bound then return end
 bound=enabled
 if enabled then
  CAS:BindAction('ApusPrimary',primary,true,Enum.KeyCode.E,Enum.KeyCode.ButtonX)
  CAS:BindAction('ApusSecondary',secondary,true,Enum.KeyCode.Q,Enum.KeyCode.ButtonY)
  CAS:SetPosition('ApusPrimary',UDim2.fromScale(.7,.48))
  CAS:SetPosition('ApusSecondary',UDim2.fromScale(.84,.32))
 else CAS:UnbindAction('ApusPrimary'); CAS:UnbindAction('ApusSecondary') end
end
status.OnClientEvent:Connect(function(s)
 data=s
 local r=s.rpg
 if r and r.ready then
  statsLabel.Text=string.format('Level %d | XP %d/%d | Gold %d | %s',r.level,r.xp,r.nextXP,r.gold,classNames[r.class] or r.class)
  questLabel.Text=r.quest..'\n'..(r.adventure or '')..'\n'..(r.notice or '')..' | '..(r.save or '')
 else statsLabel.Text='Loading profile...'; questLabel.Text='' end
 local phaseName=s.phase=='Asteptare' and ('Exploration: '..(s.night and 'Night' or 'Day')) or (phaseNames[s.phase] or s.phase)
 header.Text=string.format('%s | %ds | %d/%d | %s | Crypts: %d',phaseName,s.time,s.cycle,s.maxCycles or 3,roleNames[s.role] or s.role,s.crypts or 1)
 detail.Text=(s.captured and 'Captured: wait for the next round. ') or (s.pending and 'INFECTED: transformation at the next dusk. ') or ''
 detail.Text=detail.Text..(s.notice or '')
 if s.practice then detail.Text='PRACTICE / BOTS | '..detail.Text end
 local score=s.score or {humans=0,vampires=0}
 scoreLabel.Text=string.format('Round wins: Humans %d / Vampires %d\nAid: %s%s',score.humans,score.vampires,s.support or 'None',s.sanctuary and ' | CHURCH SANCTUARY' or '')
 local enabled=s.active and not s.captured and ((s.role=='Vampir' and s.phase=='Noapte') or s.role~='Vampir')
 bind(enabled)
 if enabled then
  local a=s.role=='Vampir' and 'Feed' or 'Investigate'
  local b=s.role=='Vampir' and 'Infect' or 'Capture'
  if s.role~='Vampir' and s.phase=='Noapte' then a='Investigate (daytime)'; b='Capture weakened' end
  CAS:SetTitle('ApusPrimary',a); CAS:SetTitle('ApusSecondary',b)
  controls.Text='PC: E '..a..' / Q '..b..' | Controller: X / Y | Mobile: action buttons'
 else controls.Text='Use Roblox movement controls. Abilities unlock in the appropriate phase.' end
end)
local elapsed=0
RunService.Heartbeat:Connect(function(dt)
 elapsed=elapsed+dt; if elapsed&lt;.2 then return end; elapsed=0
 selected=(data and data.active and not data.captured) and nearest() or nil
 targetLabel.Text=selected and ('Nearby target: '..selected.DisplayName) or 'Approach a participant to interact'
end)

-- Personal flashlight: available on touch, keyboard, and controller.
local flashlightOn=true
local function installLight(char)
 local head=char:WaitForChild('Head',10); if not head then return end
 local old=head:FindFirstChild('PersonalLantern'); if old then old:Destroy() end
 local light=Instance.new('SpotLight'); light.Name='PersonalLantern'
 light.Face=Enum.NormalId.Front; light.Range=38+6*(player:GetAttribute('LanternTier') or 0); light.Angle=85
 light.Brightness=3; light.Color=player:GetAttribute('OwnsGoldenLantern') and Color3.fromRGB(255,184,64) or Color3.fromRGB(239,224,188)
 light.Shadows=false; light.Enabled=flashlightOn; light.Parent=head
end
player.CharacterAdded:Connect(installLight)
if player.Character then task.spawn(installLight,player.Character) end
CAS:BindAction('ApusLight',function(_,state)
 if state==Enum.UserInputState.Begin then
  flashlightOn=not flashlightOn
  local head=player.Character and player.Character:FindFirstChild('Head')
  local light=head and head:FindFirstChild('PersonalLantern')
  if light then light.Enabled=flashlightOn end
 end
 return Enum.ContextActionResult.Sink
end,true,Enum.KeyCode.F,Enum.KeyCode.ButtonB)
CAS:SetTitle('ApusLight','Lantern')
CAS:SetPosition('ApusLight',UDim2.fromScale(.6,.2))

local function refreshLight()
 local head=player.Character and player.Character:FindFirstChild('Head')
 local light=head and head:FindFirstChild('PersonalLantern')
 if light then
  light.Range=38+6*(player:GetAttribute('LanternTier') or 0)
  light.Color=player:GetAttribute('OwnsGoldenLantern') and Color3.fromRGB(255,184,64) or Color3.fromRGB(239,224,188)
 end
end
player:GetAttributeChangedSignal('LanternTier'):Connect(refreshLight)
player:GetAttributeChangedSignal('OwnsGoldenLantern'):Connect(refreshLight)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX1479">
        <Properties>
          <string name="Name">Shop</string>
          <ProtectedString name="Source">local Players=game:GetService('Players')
local Marketplace=game:GetService('MarketplaceService')
local RS=game:GetService('ReplicatedStorage')
local GuiService=game:GetService('GuiService')
local UIS=game:GetService('UserInputService')
local CAS=game:GetService('ContextActionService')
local player=Players.LocalPlayer
local catalog=require(RS:WaitForChild('MonetizationConfig'))
local gui=Instance.new('ScreenGui'); gui.Name='RobuxShop'; gui.ResetOnSpawn=false
-- Keep above the gameplay HUD and inside the device safe area.
gui.DisplayOrder=10; gui.Parent=player:WaitForChild('PlayerGui')
local frame=Instance.new('Frame'); frame.AnchorPoint=Vector2.new(.5,.5)
frame.Position=UDim2.fromScale(.5,.5); frame.Size=UDim2.fromScale(.88,.82)
frame.BackgroundColor3=Color3.fromRGB(18,19,29); frame.Visible=false; frame.Parent=gui
local cap=Instance.new('UISizeConstraint'); cap.MaxSize=Vector2.new(620,440); cap.Parent=frame
local title=Instance.new('TextLabel'); title.BackgroundTransparency=1
 title.Size=UDim2.fromScale(.96,.16); title.Position=UDim2.fromScale(.02,0)
 title.Text='Optional cosmetics | Robux\nNo combat advantages'; title.TextWrapped=true
 title.TextSize=18; title.TextColor3=Color3.fromRGB(245,222,171); title.Parent=frame
local function button(text,y)
 local b=Instance.new('TextButton'); b.Size=UDim2.fromScale(.92,.17)
 b.Position=UDim2.fromScale(.04,y); b.Text=text; b.TextWrapped=true; b.TextSize=15
 b.BackgroundColor3=Color3.fromRGB(48,49,68); b.TextColor3=Color3.new(1,1,1)
 b.Selectable=true; b.Parent=frame; return b
end
local close=button('Close',.79)
local previous=nil
local function hide()
 frame.Visible=false; CAS:UnbindAction('CloseRobuxShop')
 if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(frame) then
  GuiService.SelectedObject=previous and previous.Parent and previous or nil
 end
end
close.Activated:Connect(hide)
local buttons={}; local infos={}; local fetching={}; local lastInfo={}
local busy=false
local function refresh(index)
 local entry=catalog[index]; local b=buttons[index]
 if player:GetAttribute('Owns'..entry.key) then b.Text=entry.title..' | Owned'; return end
 if entry.id&lt;=0 then b.Text=entry.title..' | Currently unavailable'; return end
 local info=infos[index]
 if not info then b.Text=entry.title..' | Checking price...'
 else b.Text=entry.title..' | '..(info.IsForSale and tostring(info.PriceInRobux)..' Robux' or 'Not for sale')..'\n'..entry.description end
end
for i,entry in ipairs(catalog) do
 local index=i; local product=entry
 buttons[index]=button(product.title,.18+(index-1)*.20)
 player:GetAttributeChangedSignal('Owns'..product.key):Connect(function() refresh(index) end)
 buttons[index].Activated:Connect(function()
  if busy or product.id&lt;=0 or player:GetAttribute('Owns'..product.key) then return end
  local info=infos[index]; if not info or not info.IsForSale then return end
  busy=true
  local ok=pcall(function() Marketplace:PromptGamePassPurchase(player,product.id) end)
  if not ok then busy=false; buttons[index].Text='Purchase unavailable. Please try again.' end
 end)
 refresh(index)
end
-- The client only clears its UI debounce; ONLY the server grants ownership effects.
Marketplace.PromptGamePassPurchaseFinished:Connect(function(p)
 if p==player then busy=false end
end)
RS:WaitForChild('OpenRobuxShop').OnClientEvent:Connect(function()
 previous=GuiService.SelectedObject; frame.Visible=true
 CAS:BindActionAtPriority('CloseRobuxShop',function(_,state)
  if state==Enum.UserInputState.Begin then hide() end
  return Enum.ContextActionResult.Sink
 end,false,3000,Enum.KeyCode.ButtonB,Enum.KeyCode.Escape)
 if UIS.GamepadEnabled then GuiService.SelectedObject=close end
 for i,entry in ipairs(catalog) do
  local index=i; local product=entry
  refresh(index)
  if product.id&gt;0 and not fetching[index] and os.clock()-(lastInfo[index] or -100)&gt;60 then
   fetching[index]=true; lastInfo[index]=os.clock()
   task.spawn(function()
    -- Fetch on THIS client so displayed prices follow Roblox regional pricing.
    local ok,info=pcall(function() return Marketplace:GetProductInfoAsync(product.id,Enum.InfoType.GamePass) end)
    if ok then infos[index]=info end
    fetching[index]=false; refresh(index)
   end)
  end
 end
end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX1480">
        <Properties>
          <string name="Name">Combat</string>
          <ProtectedString name="Source">local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local UIS=game:GetService('UserInputService')
local CAS=game:GetService('ContextActionService')
local TweenService=game:GetService('TweenService')
local player=Players.LocalPlayer
local Combat=require(RS:WaitForChild('CombatRules'))
local Actors=require(RS:WaitForChild('Actors'))
local action=RS:WaitForChild('ApusNet'):WaitForChild('Action')
local equipped=nil
local nextAttack=0
local function attack()
 if not equipped or not equipped.Parent or player:GetAttribute('Captured') then return end
 local key=equipped:GetAttribute('ApusWeapon'); local w=Combat.Weapons[key]
 local char=player.Character; local root=char and char:FindFirstChild('HumanoidRootPart')
 if not w or not root or os.clock()&lt;nextAttack or not player:GetAttribute('RoundActive') then return end
 nextAttack=os.clock()+w.cooldown
 local tool=equipped; local rest=tool.Grip
 local swing=TweenService:Create(tool,TweenInfo.new(.10),{Grip=rest*CFrame.Angles(math.rad(-40),0,0)})
 swing:Play()
 task.delay(.12,function()
  if tool.Parent then TweenService:Create(tool,TweenInfo.new(.15),{Grip=rest}):Play() end
 end)
 -- Aim assistance for all input types; the server independently validates every hit.
 local candidates={}
 for _,other in ipairs(Actors.List()) do
  local pr=other.Character and other.Character:FindFirstChild('HumanoidRootPart')
  if other~=player and pr and other:GetAttribute('RoundActive') and not other:GetAttribute('Captured') then
   local delta=pr.Position-root.Position; local d=delta.Magnitude
   if d&gt;.01 and d&lt;=w.range then
    local dot=root.CFrame.LookVector:Dot(delta.Unit)
    if dot&gt;=w.arc then table.insert(candidates,{p=other,d=d,dot=dot}) end
   end
  end
 end
 table.sort(candidates,function(a,b) return a.dot-.01*a.d&gt;b.dot-.01*b.d end)
 local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude
 for i=1,math.min(#candidates,8) do
  local candidate=candidates[i]
  local pr=candidate.p.Character and candidate.p.Character:FindFirstChild('HumanoidRootPart')
  if pr then
   ray.FilterDescendantsInstances={char,candidate.p.Character}
   if not workspace:Raycast(root.Position,pr.Position-root.Position,ray) then
    nextAttack=os.clock()+w.cooldown; action:FireServer('Weapon',candidate.p.UserId); return
   end
  end
 end
end
local function equip(tool)
 if not tool:IsA('Tool') or not tool:GetAttribute('ApusWeapon') then return end
 equipped=tool
 CAS:BindAction('ApusAttack',function(_,state)
  if state==Enum.UserInputState.Begin then attack() end
  return Enum.ContextActionResult.Sink
 end,true,Enum.KeyCode.ButtonR2)
 CAS:SetTitle('ApusAttack','Attack'); CAS:SetPosition('ApusAttack',UDim2.fromScale(.84,.55))
end
local function attach(char)
 equipped=nil; CAS:UnbindAction('ApusAttack')
 char.ChildAdded:Connect(equip)
 char.ChildRemoved:Connect(function(obj)
  if obj==equipped then equipped=nil; CAS:UnbindAction('ApusAttack') end
 end)
 for _,obj in ipairs(char:GetChildren()) do equip(obj) end
end
UIS.InputBegan:Connect(function(input,processed)
 if not processed and input.UserInputType==Enum.UserInputType.MouseButton1 then attack() end
end)
player.CharacterAdded:Connect(attach)
if player.Character then attach(player.Character) end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX1481">
        <Properties>
          <string name="Name">Presentation</string>
          <ProtectedString name="Source">-- Client-only scalability. Never changes hit validation, visibility range of targets or rewards.
local Players=game:GetService('Players')
local Lighting=game:GetService('Lighting')
local RS=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService')
local UIS=game:GetService('UserInputService')
local CAS=game:GetService('ContextActionService')
local player=Players.LocalPlayer
local Actors=require(RS:WaitForChild('Actors'))
local bloom=Lighting:FindFirstChild('ApusBloom')
local rays=Lighting:FindFirstChild('ApusSunRays')
local quality=UIS.TouchEnabled and 1 or 2
local mode=0 -- 0 auto, 1 low, 2 balanced, 3 high
local reduced=false
local bright=false
local lights={}
local shadowDefaults={}
local samples={}; local sampleTime=0; local total=0; local elapsed=0; local adjustmentAt=0
local nearbyLights=0
local gui=Instance.new('ScreenGui'); gui.Name='ApusSettings'; gui.ResetOnSpawn=false
 gui.Parent=player:WaitForChild('PlayerGui')
local function button(text,y)
 local b=Instance.new('TextButton'); b.Text=text; b.TextSize=12; b.TextWrapped=true
 b.Position=UDim2.fromScale(.02,y); b.Size=UDim2.fromScale(.22,.045)
 b.BackgroundColor3=Color3.fromRGB(24,29,38); b.TextColor3=Color3.fromRGB(240,223,183)
 b.Selectable=true; b.Parent=gui; return b
end
local graphics=button('Graphics: Auto',.46)
local motion=button('Reduced effects: Off',.51)
local brightness=button('Brightness: Normal',.56)
local metrics=Instance.new('TextLabel'); metrics.Size=UDim2.fromScale(.22,.04)
metrics.Position=UDim2.fromScale(.02,.61); metrics.BackgroundTransparency=1
metrics.TextColor3=Color3.fromRGB(202,211,221); metrics.TextSize=12; metrics.Parent=gui
local hit=Instance.new('TextLabel'); hit.AnchorPoint=Vector2.new(.5,.5)
hit.Position=UDim2.fromScale(.5,.5); hit.Size=UDim2.fromOffset(90,40)
hit.BackgroundTransparency=1; hit.TextColor3=Color3.fromRGB(246,217,146)
hit.Text='HIT'; hit.TextSize=20; hit.Visible=false; hit.Parent=gui
local hitExpires=0
local function track(obj)
 if obj:IsA('PointLight') or obj:IsA('SurfaceLight') then
  lights[obj]=true
 elseif obj:IsA('BasePart') and obj:GetAttribute('ApusDecoration') then
  shadowDefaults[obj]=obj.CastShadow
 end
end
for _,obj in ipairs(workspace:GetDescendants()) do track(obj) end
workspace.DescendantAdded:Connect(track)
workspace.DescendantRemoving:Connect(function(obj) lights[obj]=nil; shadowDefaults[obj]=nil end)
local function apply()
 if bloom then bloom.Enabled=not reduced and quality&gt;=2 end
 if rays then rays.Enabled=not reduced and quality&gt;=3 end
 Lighting.GlobalShadows=quality&gt;=2
 Lighting.ExposureCompensation=bright and .45 or 0
 for part,original in pairs(shadowDefaults) do if part.Parent then part.CastShadow=quality&gt;=3 and original end end
end
graphics.Activated:Connect(function()
 mode=(mode+1)%4
 if mode&gt;0 then quality=mode end
 graphics.Text='Graphics: '..({'Auto','Low','Balanced','High'})[mode+1]
 apply()
end)
motion.Activated:Connect(function()
 reduced=not reduced; motion.Text='Reduced effects: '..(reduced and 'On' or 'Off'); apply()
 player:SetAttribute('ApusReducedEffects',reduced)
end)
brightness.Activated:Connect(function()
 bright=not bright; brightness.Text='Brightness: '..(bright and 'Boosted' or 'Normal'); apply()
end)
RS:WaitForChild('ApusNet'):WaitForChild('Feedback').OnClientEvent:Connect(function(event)
 if event.kind=='Hit' then hit.Text='HIT'; hit.Visible=true; hitExpires=os.clock()+.3
 elseif event.kind=='Hurt' then
  -- No flashing screen or camera shake; readable text only.
  hit.Text='UNDER ATTACK'; hit.Visible=true; hitExpires=os.clock()+.5
 end
end)
-- Local spectating prevents a captured player waiting on a fixed camera.
local spectating=false; local spectateIndex=0
local function spectate()
 if not player:GetAttribute('Captured') then return end
 local targets={}
 for _,p in ipairs(Actors.List()) do
  local h=p.Character and p.Character:FindFirstChildOfClass('Humanoid')
  if p~=player and p:GetAttribute('RoundActive') and not p:GetAttribute('Captured') and h and p.Character:FindFirstChild('HumanoidRootPart') then table.insert(targets,h) end
 end
 if #targets==0 then return end
 spectateIndex=spectateIndex%#targets+1; spectating=true
 workspace.CurrentCamera.CameraSubject=targets[spectateIndex]
end
CAS:BindAction('ApusSpectate',function(_,state)
 if state==Enum.UserInputState.Begin then spectate() end
 return Enum.ContextActionResult.Pass
end,true,Enum.KeyCode.G,Enum.KeyCode.DPadRight)
CAS:SetTitle('ApusSpectate','Spectate'); CAS:SetPosition('ApusSpectate',UDim2.fromScale(.62,.12))
local function resetCamera()
 spectating=false
 local hum=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
 if hum then workspace.CurrentCamera.CameraSubject=hum end
end
player:GetAttributeChangedSignal('Captured'):Connect(function()
 if not player:GetAttribute('Captured') then resetCamera() end
end)
player.CharacterAdded:Connect(function(char)
 char:WaitForChild('Humanoid',10); resetCamera()
end)
apply()
RunService.RenderStepped:Connect(function(dt)
 if dt&lt;=0 then return end
 -- One small sample ring; never send per-frame telemetry to the server.
 samples[#samples+1]=dt*1000; if #samples&gt;180 then table.remove(samples,1) end
 total=total+dt; elapsed=elapsed+dt; sampleTime=sampleTime+1
 if hit.Visible and os.clock()&gt;hitExpires then hit.Visible=false end
 if elapsed&lt;1 then return end
 elapsed=0
 local fps=sampleTime/total; total=0; sampleTime=0
 if mode==0 and os.clock()&gt;adjustmentAt then
  if fps&lt;48 and quality&gt;1 then quality=quality-1; adjustmentAt=os.clock()+8; apply()
  elseif fps&gt;=58 and quality&lt;3 then quality=quality+1; adjustmentAt=os.clock()+25; apply() end
 end
 local sorted=table.clone(samples); table.sort(sorted)
 local p95=sorted[math.max(1,math.ceil(#sorted*.95))] or 0
 metrics.Text=string.format('%.0f FPS | p95 %.1f ms | Q%d',fps,p95,quality)
 player:SetAttribute('LocalFPS',math.floor(fps)); player:SetAttribute('LocalFrameP95',p95)
 local camera=workspace.CurrentCamera
 if camera then
  local radius=({70,110,150})[quality]; nearbyLights=0
  for light in pairs(lights) do
   local part=light.Parent
   if part and part:IsA('BasePart') then
    local enabled=workspace:GetAttribute('ApusNight') and (camera.CFrame.Position-part.Position).Magnitude&lt;=radius
    light.Enabled=enabled; light.Shadows=false
    if enabled then nearbyLights=nearbyLights+1 end
   end
  end
 end
end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX1482">
        <Properties>
          <string name="Name">Wayfinding</string>
          <ProtectedString name="Source">-- Stream-safe labels, culled by Roblox. No per-frame search or x-ray markers.
local labels={QuestBoard='QUESTS',ContractBoard='INN / CONTRACTS',
 Merchant='BLACKSMITH',Healer='HEALER',Trainer='GUILDS',RobuxShop='COSMETICS',
 Supply_Market='SUPPLIES: MARKET',Supply_Mill='SUPPLIES: MILL',Supply_Farm='SUPPLIES: FARM',
 DawnClue='CLUE: DAYTIME',DawnShrine='SEAL: NIGHTTIME',Campfire='HEARTH / COOKING',TravelGate='ENTER VILLAGE'}
local function track(part)
 if not part:IsA('BasePart') or not labels[part.Name] or not part.Parent or part.Parent.Name~='WorldNodes' then return end
 if part:FindFirstChild('ApusWayfinding') then return end
 local board=Instance.new('BillboardGui'); board.Name='ApusWayfinding'; board.Size=UDim2.fromOffset(160,28)
 board.StudsOffsetWorldSpace=Vector3.new(0,4,0); board.MaxDistance=50; board.AlwaysOnTop=false; board.Adornee=part
 local text=Instance.new('TextLabel'); text.Size=UDim2.fromScale(1,1); text.BackgroundColor3=Color3.fromRGB(27,25,24)
 text.BackgroundTransparency=.2; text.TextColor3=Color3.fromRGB(238,214,165); text.TextSize=12
 text.Font=Enum.Font.GothamMedium; text.Text=labels[part.Name]; text.Parent=board; board.Parent=part
end
for _,part in ipairs(workspace:GetDescendants()) do track(part) end
workspace.DescendantAdded:Connect(track)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX1483">
        <Properties>
          <string name="Name">Multiplayer</string>
          <ProtectedString name="Source">local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Social=game:GetService('SocialService')
local CAS=game:GetService('ContextActionService')
local p=Players.LocalPlayer
local remote=RS:WaitForChild('ApusSessions')
local gui=Instance.new('ScreenGui'); gui.Name='ApusMultiplayer'; gui.ResetOnSpawn=false; gui.DisplayOrder=20; gui.Parent=p:WaitForChild('PlayerGui')
local open=Instance.new('TextButton'); open.Name='Open'; open.Text='Multiplayer'; open.Position=UDim2.fromScale(.76,.23); open.Size=UDim2.fromScale(.22,.055); open.Parent=gui
local panel=Instance.new('ScrollingFrame'); panel.Name='Panel'; panel.CanvasSize=UDim2.new(); panel.AutomaticCanvasSize=Enum.AutomaticSize.Y; panel.ScrollBarThickness=6; panel.AnchorPoint=Vector2.new(.5,.5); panel.Position=UDim2.fromScale(.5,.5)
panel.Size=UDim2.new(.9,0,.85,0); panel.BackgroundColor3=Color3.fromRGB(29,30,38); panel.Visible=false; panel.Parent=gui
local bounds=Instance.new('UISizeConstraint'); bounds.MaxSize=Vector2.new(450,510); bounds.Parent=panel
local layout=Instance.new('UIListLayout'); layout.SortOrder=Enum.SortOrder.LayoutOrder; layout.Padding=UDim.new(0,6); layout.HorizontalAlignment=Enum.HorizontalAlignment.Center; layout.Parent=panel
local order=0
local function place(obj) order=order+1; obj.LayoutOrder=order end
local padding=Instance.new('UIPadding'); padding.PaddingTop=UDim.new(0,12); padding.PaddingLeft=UDim.new(0,12); padding.PaddingRight=UDim.new(0,12); padding.Parent=panel
local function button(name,text,callback)
 local b=Instance.new('TextButton'); b.Name=name; b.Text=text; b.Size=UDim2.new(1,-24,0,30); b.TextSize=14
 b.BackgroundColor3=Color3.fromRGB(73,63,49); b.TextColor3=Color3.fromRGB(245,225,184); b.Selectable=true; b.Parent=panel
 place(b); b.Activated:Connect(callback); return b
end
local message=Instance.new('TextLabel'); message.Name='Message'; message.Size=UDim2.new(1,-24,0,52); message.BackgroundTransparency=1
message.TextColor3=Color3.fromRGB(243,222,178); message.TextWrapped=true; message.TextSize=14; message.TextScaled=true
local messageLimit=Instance.new('UITextSizeConstraint'); messageLimit.MinTextSize=10; messageLimit.MaxTextSize=14; messageLimit.Parent=message
message.Text='MULTIPLAYER\nHost a private session. Share its code with your group (expires in 2 hours).'; place(message); message.Parent=panel
local waiting=false
local function request(kind,value)
 if waiting then return end
 waiting=true; message.Text='Working...'
 task.spawn(function()
  local ok,r=pcall(function() return remote:InvokeServer(kind,value) end)
  message.Text=ok and type(r)=='table' and r.message or 'Connection unavailable. Please try again.'
  waiting=false
 end)
end
button('Host','Host / create session',function() request('Host') end)
local code=Instance.new('TextBox'); code.Name='JoinCode'; code.PlaceholderText='8-character join code'; code.Text=''; code.ClearTextOnFocus=false
code.Size=UDim2.new(1,-24,0,32); code.TextSize=16; place(code); code.Parent=panel
button('Join','Join / enter code',function() request('Join',code.Text) end)
button('Invite','Invite friends (also share your code)',function()
 task.spawn(function()
  local ok,allowed=pcall(function() return Social:CanSendGameInviteAsync(p) end)
  if ok and allowed then
   local sent=pcall(function() Social:PromptGameInvite(p) end)
   if not sent then message.Text='Invitation unavailable. Use the session code.' end
  else message.Text='Invitations are unavailable here. Use the session code.' end
 end)
end)
local counts={0,3,7,12}
local botButton=button('Bots','Studio: bots 0 / 3 / 7 / 12',function()
 local current=workspace:GetAttribute('ApusPendingBotCount') or workspace:GetAttribute('ApusBotCount') or 0
 local index=table.find(counts,current) or 1
 request('Bots',counts[index%#counts+1])
end)
local function refreshBots()
 local count=workspace:GetAttribute('ApusBotCount') or 0
 local waitingPhase=workspace:GetAttribute('ApusPhase')=='Asteptare'
 local pending=workspace:GetAttribute('ApusPendingBotCount')
 botButton.Text='Studio: '..count..' bots | '..(pending~=nil and ('next: '..pending) or (waitingPhase and 'change 0/3/7/12' or 'change after round'))
end
workspace:GetAttributeChangedSignal('ApusBotCount'):Connect(refreshBots)
workspace:GetAttributeChangedSignal('ApusPhase'):Connect(refreshBots)
workspace:GetAttributeChangedSignal('ApusPendingBotCount'):Connect(refreshBots)
refreshBots()
button('Close','Close',function() panel.Visible=false end)
local function refreshCode()
 local value=p:GetAttribute('ApusJoinCode')
 if value then code.Text=value; message.Text='Session code: '..value..' (2 hours)' end
end
p:GetAttributeChangedSignal('ApusJoinCode'):Connect(refreshCode)
p:GetAttributeChangedSignal('ApusSessionError'):Connect(function() message.Text=p:GetAttribute('ApusSessionError') or '' end)
local function toggle() panel.Visible=not panel.Visible; if panel.Visible then refreshCode() end end
open.Activated:Connect(toggle)
CAS:BindAction('ApusMultiplayerMenu',function(_,state) if state==Enum.UserInputState.Begin then toggle() end return Enum.ContextActionResult.Pass end,false,Enum.KeyCode.M,Enum.KeyCode.ButtonSelect)
task.spawn(function()
 local ok,info=pcall(function() return remote:InvokeServer('Info') end)
 if ok and type(info)=='table' then botButton.Visible=info.studio end
end)
</ProtectedString>
