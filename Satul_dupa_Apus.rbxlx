  <Item class="ServerScriptService" referent="RBX1099">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX1100">
      <Properties>
        <string name="Name">Config</string>
        <ProtectedString name="Source">-- The admission cap must ALSO be set to 50 in Creator Dashboard place settings.
return {
 MinPlayers=2, MaxPlayers=50, Day=240, Night=180, Cycles=3, Intermission=20,
 Range=10, InspectCooldown=20, CaptureCooldown=5, FeedCooldown=8, InfectCooldown=25,
 SaveInterval=90, LockLifetime=300, MaxLevel=30,
 -- Studio uses disposable profiles by default. Never enable API access on live data for tests.
 StudioPersistence=false,
}
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1101">
      <Properties>
        <string name="Name">Progression</string>
        <ProtectedString name="Source">-- Server-owned RPG profiles, session leases, quests and contextual interactions.
local Players=game:GetService('Players')
local DSS=game:GetService('DataStoreService')
local RunService=game:GetService('RunService')
local Http=game:GetService('HttpService')
local Config=require(script.Parent.Config)
local RPG={}
local profiles={}
local session=game.JobId..':'..Http:GenerateGUID(false)
local store=DSS:GetDataStore('ApusRPG_v1')
local temporary=RunService:IsStudio() and not Config.StudioPersistence
local closing=false
local classes={'Vanator','Cercetas','Carturar'}
local quests={
 {kind='Herb',need=5,text='Culege 5 ierburi in padurea de la sud-vest',xp=100,gold=50},
 {kind='Ore',need=4,text='Aduna 4 minereuri din mina de la est',xp=140,gold=70},
 {kind='Relic',need=3,text='Gaseste 3 relicve in ruinele de la nord',xp=180,gold=90},
 {kind='Ritual',need=1,text='Activeaza altarul manastirii din sud',xp=240,gold=120},
}
local function integer(n,max)
 if type(n)~='number' or n~=n or n==math.huge or n==-math.huge then return 0 end
 return math.clamp(math.floor(n),0,max)
end
local function clean(raw)
 raw=type(raw)=='table' and raw or {}
 local q=integer(raw.quest,4); if q&lt;1 then q=1 end
 local class='Vanator'
 for _,v in ipairs(classes) do if raw.class==v then class=v end end
 return {xp=integer(raw.xp,10000000),gold=integer(raw.gold,10000000),
  lantern=integer(raw.lantern,3),class=class,quest=q,
  count=integer(raw.count,quests[q].need),accepted=raw.accepted==true,
  completed=integer(raw.completed,1000000),wins=integer(raw.wins,1000000)}
end
local function copy(d) local c={}; for k,v in pairs(d) do c[k]=v end; return c end
function RPG.Level(xp)
 return math.min(Config.MaxLevel,1+math.floor(math.sqrt(xp/100)))
end
local function publish(p,s)
 local d=s.data
 p:SetAttribute('RPGReady',true)
 p:SetAttribute('LanternTier',d.lantern)
 local stats=p:FindFirstChild('leaderstats')
 if stats then stats.Nivel.Value=RPG.Level(d.xp); stats.Aur.Value=d.gold end
end
local function reward(p,s,xp,gold)
 -- No client can supply reward amounts, item prices or quest completion.
 s.data.xp=math.min(10000000,s.data.xp+xp)
 s.data.gold=math.min(10000000,s.data.gold+gold)
 publish(p,s)
end
local function notice(p,text) p:SetAttribute('RPGNotice',text) end
function RPG.Ready(p) return profiles[p]~=nil and not profiles[p].leaving end
function RPG.Join(p)
 if closing then p:Kick('Serverul se inchide. Reconecteaza-te.'); return end
 local data=nil
 if temporary then data=clean(nil) else
  for attempt=1,3 do
   local ok,result=pcall(function()
    return store:UpdateAsync('u_'..p.UserId,function(old)
     old=type(old)=='table' and old or {}
     local lock=old.lock
     if type(lock)=='table' and lock.id~=session and type(lock.at)=='number'
       and os.time()-lock.at&lt;Config.LockLifetime then return nil end
     return {version=1,data=clean(old.data),lock={id=session,at=os.time()}}
    end)
   end)
   if ok and type(result)=='table' and result.lock and result.lock.id==session then
    data=clean(result.data); break
   end
   task.wait(attempt)
  end
 end
 if not data then
  if p.Parent==Players then p:Kick('Profil indisponibil sau deschis pe alt server. Reincearca in cateva minute.') end
  return
 end
 profiles[p]={data=data,saving=false,leaving=false,lastSave=os.clock(),nodes={},visits={},nextUse=0}
 if p.Parent~=Players or closing then RPG.Remove(p); return end
 local stats=Instance.new('Folder'); stats.Name='leaderstats'; stats.Parent=p
 for _,n in ipairs({'Nivel','Aur'}) do local v=Instance.new('IntValue'); v.Name=n; v.Parent=stats end
 p:SetAttribute('SaveStatus',temporary and 'TEST - progres temporar' or 'Salvare activa')
 notice(p,'Sfat: tabla de misiuni este langa fantana. Interactiune: R / L1 / atingere.')
 publish(p,profiles[p])
end
local function save(p,release)
 local s=profiles[p]; if not s then return true end
 local deadline=os.clock()+20
 while s.saving and os.clock()&lt;deadline do task.wait(.1) end
 if s.saving then return false end
 s.saving=true
 if temporary then s.saving=false; return true end
 local payload=copy(s.data)
 local succeeded=false
 local lost=false
 for attempt=1,3 do
  local ok,result=pcall(function()
   return store:UpdateAsync('u_'..p.UserId,function(old)
    if type(old)~='table' or type(old.lock)~='table' or old.lock.id~=session then
     lost=true; return nil
    end
    return {version=1,data=payload,lock=not release and {id=session,at=os.time()} or nil}
   end)
  end)
  if ok and result and not lost then succeeded=true; break end
  if lost then break end
  task.wait(attempt)
 end
 s.saving=false
 if succeeded then
  s.lastSave=os.clock(); p:SetAttribute('SaveStatus','Salvat')
 else
  p:SetAttribute('SaveStatus','Salvare esuata - reincercare automata')
  warn('Apus profile save failed for user '..p.UserId)
  if lost or os.clock()-s.lastSave&gt;Config.LockLifetime-30 then
   s.leaving=true
   if p.Parent==Players then p:Kick('Conexiunea cu salvarea s-a intrerupt. Reconecteaza-te.') end
  end
 end
 return succeeded
end
function RPG.Remove(p)
 local s=profiles[p]; if not s then return end
 if s.removing then return end
 s.removing=true; s.leaving=true
 local ok=save(p,true)
 if not ok then warn('Final save failed; lock expires automatically for '..p.UserId) end
 profiles[p]=nil
end
function RPG.Snapshot(p)
 local s=profiles[p]
 if not s then return {ready=false} end
 local d=s.data; local q=quests[d.quest]
 return {ready=true,level=RPG.Level(d.xp),xp=d.xp,nextXP=Config.MaxLevel&gt;RPG.Level(d.xp)
  and 100*RPG.Level(d.xp)^2 or d.xp,gold=d.gold,class=d.class,lantern=d.lantern,
  quest=d.accepted and (q.text..' ('..d.count..'/'..q.need..')') or 'Vorbeste cu tabla de misiuni din piata',
  completed=d.completed,save=p:GetAttribute('SaveStatus'),notice=p:GetAttribute('RPGNotice')}
end
function RPG.RoundReward(p,won)
 local s=profiles[p]; if not s or s.leaving then return end
 reward(p,s,won and 160 or 60,won and 80 or 25)
 if won then s.data.wins=s.data.wins+1 end
end
local function progress(p,s,kind)
 local d=s.data; local q=quests[d.quest]
 if not d.accepted or kind~=q.kind or d.count&gt;=q.need then return end
 d.count=d.count+1
 notice(p,d.count&gt;=q.need and 'Obiectiv complet. Revino la tabla de misiuni pentru recompensa.'
  or (q.text..' '..d.count..'/'..q.need))
end
function RPG.Init(canInteract)
 local nodes=workspace.Village:WaitForChild('WorldNodes')
 for _,part in ipairs(nodes:GetChildren()) do
  if part:IsA('BasePart') and part.Name~='RobuxShop' then
   local name=part.Name
   local prompt=Instance.new('ProximityPrompt')
   prompt.Name='RPGInteract'; prompt.MaxActivationDistance=10
   prompt.RequiresLineOfSight=true; prompt.HoldDuration=.5
   prompt.KeyboardKeyCode=Enum.KeyCode.R; prompt.GamepadKeyCode=Enum.KeyCode.ButtonL1
   prompt.ObjectText=name; prompt.ActionText='Interactioneaza'
   if name:match('^Herb_') then prompt.ObjectText='Ierburi'; prompt.ActionText='Culege'
   elseif name:match('^Ore_') then prompt.ObjectText='Minereu'; prompt.ActionText='Extrage'
   elseif name:match('^Relic_') then prompt.ObjectText='Relicva'; prompt.ActionText='Cerceteaza'
   elseif name=='QuestBoard' then prompt.ObjectText='Misiuni'; prompt.ActionText='Accepta / Incaseaza'
   elseif name=='Merchant' then prompt.ObjectText='Fierar'; prompt.ActionText='Lanterna +1 (100/200/300 aur)'
   elseif name=='Healer' then prompt.ObjectText='Vindecator'; prompt.ActionText='Vindeca (30 aur)'
   elseif name=='Trainer' then prompt.ObjectText='Breasla'; prompt.ActionText='Schimba specializarea'
   elseif name=='TravelGate' then prompt.ObjectText='Spre sat'; prompt.ActionText='Exploreaza'
   elseif name:match('^Expedition_') then prompt.ObjectText='Expeditie'; prompt.ActionText='Exploreaza 3 repere'
   elseif name=='RitualAltar' then prompt.ObjectText='Altar'; prompt.ActionText='Activeaza ritualul' end
   prompt.Parent=part
   prompt.Triggered:Connect(function(p)
    local s=profiles[p]; local char=p.Character
    local root=char and char:FindFirstChild('HumanoidRootPart')
    local hum=char and char:FindFirstChildOfClass('Humanoid')
    if not s or s.leaving or not root or not hum or hum.Health&lt;=0 or not canInteract(p)
      or not prompt.Enabled or (root.Position-part.Position).Magnitude&gt;10 then return end
    local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude
    ray.FilterDescendantsInstances={char,part}
    if workspace:Raycast(root.Position,part.Position-root.Position,ray) then return end
    local now=os.clock(); if now&lt;s.nextUse then return end
    s.nextUse=now+1
    local d=s.data
    if name=='TravelGate' then
     if p:GetAttribute('RoundActive') then return end
     char:PivotTo(CFrame.new(0,4,-20)); notice(p,'Explorare PvE. Vei participa la urmatoarea runda.'); return
    elseif name=='QuestBoard' then
     local q=quests[d.quest]
     if not d.accepted then d.accepted=true; notice(p,q.text)
     elseif d.count&gt;=q.need then
      reward(p,s,q.xp,q.gold); d.completed=d.completed+1
      d.quest=d.quest%#quests+1; d.count=0; d.accepted=false
      notice(p,'Recompensa: '..q.xp..' XP, '..q.gold..' aur. Accepta urmatoarea misiune.')
     else notice(p,q.text..' '..d.count..'/'..q.need) end
    elseif name=='Merchant' then
     local cost=100*(d.lantern+1)
     if d.lantern&gt;=3 then notice(p,'Lanterna este deja la nivelul maxim.')
     elseif d.gold&lt;cost then notice(p,'Ai nevoie de '..cost..' aur.')
     else d.gold=d.gold-cost; d.lantern=d.lantern+1; publish(p,s); notice(p,'Lanterna imbunatatita permanent.') end
    elseif name=='Healer' then
     if hum.Health&gt;=hum.MaxHealth then notice(p,'Sanatatea este deja completa.')
     elseif d.gold&lt;30 then notice(p,'Vindecarea costa 30 aur.')
     else d.gold=d.gold-30; hum.Health=hum.MaxHealth; publish(p,s); notice(p,'Sanatate refacuta. Infectia NU este vindecata.') end
    elseif name=='Trainer' then
     local index=table.find(classes,d.class) or 1
     d.class=classes[index%#classes+1]; publish(p,s)
     notice(p,'Specializare: '..d.class..'. Vanator: aur +2, Cercetas: expeditii +20 XP, Carturar: cules +2 XP.')
    elseif name:match('^Expedition_') then
     s.visits[name]=true
     local count=0; for _ in pairs(s.visits) do count=count+1 end
     if count&gt;=3 then
      if now&gt;=(s.expeditionAt or 0) then
       reward(p,s,d.class=='Cercetas' and 200 or 180,90)
       s.expeditionAt=now+300; s.visits={}; notice(p,'Expeditie terminata: XP si aur primite.')
      else notice(p,'Recompensa expeditiei este disponibila o data la 5 minute.') end
     else notice(p,'Expeditie: '..count..'/3 repere vizitate (padure, mina, ruine).') end
    else
     local kind=name:match('^(%a+)_')
     if name=='RitualAltar' then kind='Ritual' end
     if kind~='Herb' and kind~='Ore' and kind~='Relic' and kind~='Ritual' then return end
     -- Personal node cooldowns: 50 players never compete for one resource spawn.
     if now&lt;(s.nodes[name] or 0) then notice(p,'Resursa se reface pentru tine.'); return end
     s.nodes[name]=now+60
     reward(p,s,d.class=='Carturar' and 10 or 8,d.class=='Vanator' and 6 or 4)
     progress(p,s,kind)
    end
   end)
  end
 end
 task.spawn(function()
  while not closing do
   task.wait(2)
   -- Spread saves across the interval instead of issuing 50 writes at once.
   for p,s in pairs(profiles) do
    if not s.leaving and not s.saving and os.clock()-s.lastSave&gt;=Config.SaveInterval then
     task.spawn(save,p,false); task.wait(.2)
    end
   end
  end
 end)
 game:BindToClose(function()
  closing=true
  for p in pairs(profiles) do task.spawn(RPG.Remove,p) end
  local deadline=os.clock()+25
  while next(profiles) and os.clock()&lt;deadline do task.wait(.1) end
 end)
end
return RPG
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1102">
      <Properties>
        <string name="Name">Monetization</string>
        <ProtectedString name="Source">local Players=game:GetService('Players')
local Marketplace=game:GetService('MarketplaceService')
local RS=game:GetService('ReplicatedStorage')
local catalog=require(RS:WaitForChild('MonetizationConfig'))
local Monetization={}
local function decorate(p,char)
 if p.Character~=char then return end
 local head=char:FindFirstChild('Head')
 if not head then return end
 local aura=char:FindFirstChild('PaidMoonAura')
 if p:GetAttribute('OwnsMoonAura') and not aura then
  aura=Instance.new('Highlight'); aura.Name='PaidMoonAura'
  aura.FillTransparency=1; aura.OutlineColor=Color3.fromRGB(114,173,255)
  aura.DepthMode=Enum.HighlightDepthMode.Occluded; aura.Parent=char
 end
 if p:GetAttribute('OwnsSupporter') and not head:FindFirstChild('SupporterTitle') then
  local board=Instance.new('BillboardGui'); board.Name='SupporterTitle'
  board.Size=UDim2.fromOffset(180,28); board.StudsOffset=Vector3.new(0,3,0); board.MaxDistance=60
  local text=Instance.new('TextLabel'); text.Size=UDim2.fromScale(1,1)
  text.BackgroundTransparency=1; text.Text='SUSTINATOR AL SATULUI'
  text.TextColor3=Color3.fromRGB(245,211,124); text.TextSize=12; text.Parent=board; board.Parent=head
 end
end
function Monetization.Refresh(p,onlyID)
 for _,entry in ipairs(catalog) do
  if entry.id&gt;0 and (not onlyID or entry.id==onlyID) then
   local ok,owns=pcall(function() return Marketplace:UserOwnsGamePassAsync(p.UserId,entry.id) end)
   if ok and p.Parent==Players then p:SetAttribute('Owns'..entry.key,owns) end
  end
 end
 if p.Character then decorate(p,p.Character) end
end
function Monetization.Join(p)
 p.CharacterAdded:Connect(function(char)
  char:WaitForChild('Head',10); decorate(p,char)
 end)
 task.spawn(Monetization.Refresh,p)
end
function Monetization.Init()
 local remote=Instance.new('RemoteEvent'); remote.Name='OpenRobuxShop'; remote.Parent=RS
 -- This is server -&gt; client only. No remote grants entitlements or currency.
 local part=workspace.Village.WorldNodes:WaitForChild('RobuxShop')
 local prompt=Instance.new('ProximityPrompt'); prompt.ActionText='Vezi cosmetice'
 prompt.ObjectText='Magazin Robux'; prompt.KeyboardKeyCode=Enum.KeyCode.R
 prompt.GamepadKeyCode=Enum.KeyCode.ButtonL1; prompt.MaxActivationDistance=10
 prompt.HoldDuration=.3; prompt.Parent=part
 local last={}
 prompt.Triggered:Connect(function(p)
  local char=p.Character; local root=char and char:FindFirstChild('HumanoidRootPart')
  local hum=char and char:FindFirstChildOfClass('Humanoid')
  if not root or not hum or hum.Health&lt;=0 or p:GetAttribute('Captured') or not prompt.Enabled
    or (root.Position-part.Position).Magnitude&gt;10 or os.clock()&lt;(last[p] or 0) then return end
  local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
  params.FilterDescendantsInstances={char,part}
  if workspace:Raycast(root.Position,part.Position-root.Position,params) then return end
  last[p]=os.clock()+2; remote:FireClient(p)
 end)
 Marketplace.PromptGamePassPurchaseFinished:Connect(function(p,id,purchased)
  if purchased then task.spawn(Monetization.Refresh,p,id) end
 end)
 Players.PlayerRemoving:Connect(function(p) last[p]=nil end)
end
return Monetization
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1103">
      <Properties>
        <string name="Name">Rules</string>
        <ProtectedString name="Source">-- Pure rules shared by the round controller and behavior tests.
local Rules={}
function Rules.CryptCount(players)
 return math.max(1,math.min(5,math.ceil(players/10)))
end
function Rules.InitialVampires(players)
 return Rules.CryptCount(players)
end
function Rules.JailSlot(prisoners,count)
 local used={}; local sizes={}
 for i=1,count do used[i]={}; sizes[i]=0 end
 for _,s in ipairs(prisoners) do
  if s.jail and s.jail&lt;=count then
   sizes[s.jail]=sizes[s.jail]+1; used[s.jail][s.jailSlot or 0]=true
  end
 end
 local best=1
 for i=2,count do if sizes[i]&lt;sizes[best] then best=i end end
 local slot=0; while used[best][slot] do slot=slot+1 end
 return best,slot
end
return Rules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX1104">
      <Properties>
        <string name="Name">Game</string>
        <ProtectedString name="Source">-- Satul dupa Apus: server-authoritative prototype. No external assets.
local Players = game:GetService('Players')
local RS = game:GetService('ReplicatedStorage')
local Lighting = game:GetService('Lighting')
local net = Instance.new('Folder'); net.Name = 'ApusNet'; net.Parent = RS
local action = Instance.new('RemoteEvent'); action.Name = 'Action'; action.Parent = net
local status = Instance.new('RemoteEvent'); status.Name = 'Status'; status.Parent = net
local C=require(script.Parent.Config)
local Rules=require(script.Parent.Rules)
local RPG=require(script.Parent.Progression)
local Monetization=require(script.Parent.Monetization)
Monetization.Init()
local states = {}
local phase, remaining, cycle, running, roundId = 'Asteptare', 0, 0, false, 0
local message = 'Sunt necesari minimum doi jucatori.'
local spawns = workspace:WaitForChild('Village'):WaitForChild('Spawns'):GetChildren()
table.sort(spawns,function(a,b) return tonumber(a.Name:match('%d+'))&lt;tonumber(b.Name:match('%d+')) end)
local cryptFolder=workspace.Village:WaitForChild('Crypts')
local crypts=cryptFolder:GetChildren()
table.sort(crypts,function(a,b) return a.Name&lt;b.Name end)
local activeCrypts=1
local cryptVisuals={}
local lobby = workspace.Village.LobbyPoint
local function root(p) return p.Character and p.Character:FindFirstChild('HumanoidRootPart') end
local function humanoid(p) return p.Character and p.Character:FindFirstChildOfClass('Humanoid') end
local function alive(p)
 local s=states[p]; local h=humanoid(p)
 return s and s.active and not s.captured and h and h.Health&gt;0 and root(p)
end
local function move(p, pos)
 local r=root(p); if r then p.Character:PivotTo(CFrame.new(pos)) end
end
local function tell(p,t) local s=states[p]; if s then s.notice=t; s.noticeUntil=os.clock()+5 end end
local function paint(p)
 local s=states[p]; if not s or not p.Character then return end
 p:SetAttribute('RoundActive',s.active); p:SetAttribute('Captured',s.captured)
 local old=p.Character:FindFirstChild('Revealed'); if old then old:Destroy() end
 if s.active and not s.captured and s.vampire and (phase=='Noapte' or (s.reveal or 0)&gt;os.clock()) then
  local h=Instance.new('Highlight'); h.Name='Revealed'; h.FillColor=Color3.fromRGB(155,20,55)
  h.FillTransparency=0.6; h.OutlineColor=Color3.fromRGB(255,90,95)
  h.DepthMode=Enum.HighlightDepthMode.Occluded; h.Parent=p.Character
 end
 local pr=root(p); if pr then pr.Anchored=s.captured end
 local hum=humanoid(p)
 if hum then
  hum.WalkSpeed=(s.captured and 0) or (phase=='Noapte' and s.vampire and s.active and 20) or 16
  hum.JumpPower=s.captured and 0 or 50; hum.JumpHeight=s.captured and 0 or 7.2
 end
end
local function counts()
 local humans,vamps=0,0
 for p,s in pairs(states) do if s.active and not s.captured and p.Parent==Players then
  if s.vampire then vamps=vamps+1 else humans=humans+1 end
 end end
 return humans,vamps
end
local function winner()
 local h,v=counts()
 if v==0 then return 'Satenii au castigat: toti vampirii au fost capturati.' end
 if h==0 then return 'Vampirii au castigat: satul a fost cucerit.' end
 return nil
end
local function validTarget(p, id)
 if type(id)~='number' or id~=id or id==math.huge or id==-math.huge or id%1~=0 then return nil end
 local target=Players:GetPlayerByUserId(id)
 if not target or target==p or not alive(p) or not alive(target) then return nil end
 local a,b=root(p),root(target)
 if (a.Position-b.Position).Magnitude&gt;C.Range then return nil end
 local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude
 ray.FilterDescendantsInstances={p.Character,target.Character}
 if workspace:Raycast(a.Position,b.Position-a.Position,ray) then return nil end
 return target
end
local function jailPosition(p)
 local s=states[p]; local index=s and s.jail or 1
 local point=crypts[math.clamp(index,1,activeCrypts)].JailPoint
 -- A fixed personal slot prevents up to ten captives occupying the same point.
 local slot=s and s.jailSlot or 0
 return point.Position+Vector3.new((slot%4-1.5)*6,3,(math.floor(slot/4)-1)*6)
end
local function assignJail(p)
 local prisoners={}
 for other,t in pairs(states) do
  if other~=p and t.active and t.captured then table.insert(prisoners,t) end
 end
 local jail,slot=Rules.JailSlot(prisoners,activeCrypts)
 states[p].jail=jail; states[p].jailSlot=slot
end
local function updateCrypts()
 local count=0
 for p,s in pairs(states) do if s.active and p.Parent==Players then count=count+1 end end
 local desired=Rules.CryptCount(count)
 activeCrypts=desired
 -- Move prisoners out before closing any occupied crypt.
 for p,s in pairs(states) do
  if s.active and s.captured and (not s.jail or s.jail&gt;desired) then
   assignJail(p); move(p,jailPosition(p))
  end
 end
 for i,crypt in ipairs(crypts) do
  local enabled=i&lt;=desired
  crypt:SetAttribute('Active',enabled)
  for _,obj in ipairs(crypt:GetDescendants()) do
   if obj:IsA('BasePart') then
    if not cryptVisuals[obj] then cryptVisuals[obj]={obj.Transparency,obj.CanCollide} end
    obj.Transparency=enabled and cryptVisuals[obj][1] or 1
    obj.CanCollide=enabled and cryptVisuals[obj][2] or false
   elseif obj:IsA('SurfaceGui') then obj.Enabled=enabled end
  end
 end
 workspace.Village:SetAttribute('ActiveCrypts',desired)
end
local function capture(target)
 local s=states[target]; s.captured=true; s.pending=false
 assignJail(target); move(target,jailPosition(target)); paint(target)
 tell(target,'Capturat in cripta '..s.jail..' pana la sfarsitul rundei.')
end
updateCrypts()
RPG.Init(function(p)
 local s=states[p]
 return s and not s.captured and phase~='Rezultat'
end)
local allowed={Inspect=true,Capture=true,Feed=true,Infect=true}
action.OnServerEvent:Connect(function(p, kind, id)
 local s=states[p]
 if not s or type(kind)~='string' or not allowed[kind] then return end
 local now=os.clock()
 if now&lt;(s.nextRequest or 0) then return end
 s.nextRequest=now+0.25
 if not running then return end
 local target=validTarget(p,id); if not target then tell(p,'Apropie-te de o tinta vizibila, la maximum 10 studs.'); return end
 local t=states[target]
 local cd=C[kind..'Cooldown']
 if now&lt;(s.cooldowns[kind] or 0) then tell(p,'Abilitatea se reincarca.'); return end
 if kind=='Inspect' then
  if s.vampire or phase~='Zi' then return end
  s.cooldowns[kind]=now+cd
  if t.vampire then t.reveal=now+15; paint(target); tell(p,'Vampir descoperit! Captureaza-l in 15 secunde.')
  elseif t.pending then tell(p,'Tinta este infectata. Se transforma la urmatorul apus.')
  else tell(p,'Tinta este om.') end
 elseif kind=='Capture' then
  if s.vampire or phase~='Zi' then return end
  s.cooldowns[kind]=now+cd
  if t.vampire and (t.reveal or 0)&gt;now then capture(target); tell(p,'Vampir capturat in cripta.')
  else tell(p,'Capturezi doar vampiri descoperiti prin investigare.') end
 elseif kind=='Feed' then
  if not s.vampire or phase~='Noapte' or t.vampire then return end
  s.cooldowns[kind]=now+cd
  local th=humanoid(target); local sh=humanoid(p)
  -- Nonlethal stylized feed: nobody is removed from play by health damage.
  th.Health=math.max(25,th.Health-20); sh.Health=math.min(sh.MaxHealth,sh.Health+25)
  tell(target,'Un vampir s-a hranit! Cauta protectia celorlalti.'); tell(p,'Ti-ai refacut sanatatea.')
 elseif kind=='Infect' then
  if not s.vampire or phase~='Noapte' or t.vampire or t.pending or s.infections&lt;1 then return end
  s.cooldowns[kind]=now+cd; s.infections=s.infections-1; t.pending=true
  tell(target,'Esti infectat. Devii vampir la urmatorul apus.'); tell(p,'Infectare reusita. Transformarea are loc la urmatorul apus.')
 end
end)
local function attach(p,char)
 local h=char:WaitForChild('Humanoid',10); local r=char:WaitForChild('HumanoidRootPart',10)
 if not h or not r or not states[p] then return end
 local s=states[p]
 if s.active then
  if s.captured then move(p,jailPosition(p))
  else move(p,spawns[math.random(#spawns)].Position+Vector3.new(0,3,0)) end
 else move(p,lobby.Position+Vector3.new(0,3,0)) end
 paint(p)
 h.Died:Connect(function()
  if states[p] and running and states[p].active then
   -- Reset/death cannot erase infection or escape capture.
   capture(p)
  end
 end)
end
local function join(p)
 states[p]={active=false,vampire=false,captured=false,pending=false,cooldowns={},infections=0}
 p.CharacterAdded:Connect(function(char) attach(p,char) end)
 if p.Character then task.spawn(attach,p,p.Character) end
 task.spawn(RPG.Join,p)
 Monetization.Join(p)
end
Players.PlayerAdded:Connect(join)
Players.PlayerRemoving:Connect(function(p)
 states[p]=nil; updateCrypts(); RPG.Remove(p)
end)
for _,p in ipairs(Players:GetPlayers()) do join(p) end
local function readyRoster()
 local roster={}
 for _,p in ipairs(Players:GetPlayers()) do
  local h=humanoid(p)
  if RPG.Ready(p) and h and h.Health&gt;0 and root(p) then table.insert(roster,p) end
 end
 return roster
end
local function setPhase(name,seconds)
 phase=name; remaining=seconds
 Lighting.ClockTime=(name=='Noapte' and 0) or 14
 Lighting.Brightness=(name=='Noapte' and 1) or 2
 Lighting.Ambient=(name=='Noapte' and Color3.fromRGB(65,65,95)) or Color3.fromRGB(130,125,115)
 for p in pairs(states) do paint(p) end
end
local function waitPhase(seconds,check)
 for i=seconds,1,-1 do
  remaining=i
  if check then local result=winner(); if result then return result end end
  task.wait(1)
 end
 return check and winner() or nil
end
task.spawn(function()
 while true do
  for p,s in pairs(states) do
   local role='Spectator'
   if s.active then role=s.vampire and 'Vampir' or 'Satean' end
   local note=(s.noticeUntil or 0)&gt;os.clock() and s.notice or message
   status:FireClient(p,{phase=phase,time=remaining,cycle=cycle,maxCycles=C.Cycles,role=role,
    captured=s.captured,pending=s.pending,active=s.active,notice=note,
    infections=s.infections,crypts=activeCrypts,rpg=RPG.Snapshot(p), cooldowns={Inspect=math.max(0,(s.cooldowns.Inspect or 0)-os.clock()),
    Feed=math.max(0,(s.cooldowns.Feed or 0)-os.clock()),Infect=math.max(0,(s.cooldowns.Infect or 0)-os.clock())}})
   if phase=='Zi' and (s.reveal or 0)&gt;0 and s.reveal&lt;=os.clock() then s.reveal=0; paint(p) end
  end
  task.wait(0.5)
 end
end)
while true do
 running=false; cycle=0; setPhase('Asteptare',0)
 message='Sunt necesari minimum doi jucatori. Cei intrati in timpul rundei asteapta aici.'
 repeat task.wait(1) until #readyRoster()&gt;=C.MinPlayers
 message='Runda incepe curand.'; setPhase('Pregatire',C.Intermission); waitPhase(C.Intermission,false)
 if #readyRoster()&gt;=C.MinPlayers then
  roundId=roundId+1
  local roster=readyRoster()
  while #roster&gt;C.MaxPlayers do table.remove(roster) end
  -- Fisher-Yates shuffle; 1 initial vampire per 10 players, maximum 5.
  for i=#roster,2,-1 do local j=math.random(i); roster[i],roster[j]=roster[j],roster[i] end
  local initialVampires=Rules.InitialVampires(#roster)
  for index,p in ipairs(roster) do
   local s=states[p]; s.active=true; s.vampire=(index&lt;=initialVampires); s.captured=false; s.pending=false
   s.cooldowns={}; s.infections=0; s.reveal=0; s.jail=nil; s.jailSlot=nil
   local h=humanoid(p)
   if not h or h.Health&lt;=0 then p:LoadCharacterAsync() else
    h.Health=h.MaxHealth; move(p,spawns[index].Position+Vector3.new(0,3,0))
   end
  end
  updateCrypts()
  running=true
  local result=nil
  for n=1,C.Cycles do
   cycle=n; message='Ziua: investigheaza si captureaza vampirii descoperiti.'
   setPhase('Zi',C.Day); result=waitPhase(C.Day,true); if result then break end
   for p,s in pairs(states) do if s.active and not s.captured then
    if s.pending then s.vampire=true; s.pending=false; tell(p,'Transformarea s-a incheiat. Esti vampir!') end
    if s.vampire then s.infections=1 end
   end end
   message='Noaptea: ramaneti impreuna. Vampirii pot vana.'
   setPhase('Noapte',C.Night); result=waitPhase(C.Night,true); if result then break end
  end
  running=false
  local vampireVictory=result~=nil and string.find(result,'Vampirii au castigat',1,true)~=nil
  for p,s in pairs(states) do
   if s.active then RPG.RoundReward(p,s.vampire==vampireVictory) end
  end
  message=result or 'Satenii au castigat: au supravietuit celor trei nopti.'
  setPhase('Rezultat',10); waitPhase(10,false)
  for p,s in pairs(states) do
   s.active=false; s.captured=false; s.pending=false; s.vampire=false
   paint(p); move(p,lobby.Position+Vector3.new(0,3,0))
  end
  updateCrypts()
 end
end
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="RBX1105">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX1106">
      <Properties>
        <string name="Name">MonetizationConfig</string>
        <ProtectedString name="Source">-- Create these passes under YOUR experience. Zero means disabled, never a test charge.
-- Prices are configured on Roblox and fetched dynamically by the client.
return {
 {key='GoldenLantern',id=0,title='Lanterna aurie',description='Culoare aurie, fara bonus de raza sau putere.'},
 {key='MoonAura',id=0,title='Aura lunii',description='Efect albastru cosmetic, indiferent de rol.'},
 {key='Supporter',id=0,title='Sustinator al satului',description='Titlu cosmetic deasupra personajului.'},
}
</ProtectedString>
